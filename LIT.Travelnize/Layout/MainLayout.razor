@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider Theme="@MyCustomTheme" @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Dense="true" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />        
        <MudAvatar Size="Size.Small" Class="me-2 bg-light">
            <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
        </MudAvatar>
        <MudText Typo="Typo.h6">Travelnize</MudText>
        <MudSpacer />
        <LoginDisplay />
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Docked">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudThemeProvider _mudThemeProvider = default!;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = _mudThemeProvider.IsDarkMode;
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private MudTheme MyCustomTheme = new MudTheme()
    {
        PaletteLight = new MudBlazor.PaletteLight
        {
            AppbarBackground = new MudBlazor.Utilities.MudColor("#003D59"),
            Primary = new MudBlazor.Utilities.MudColor("#003D59"),
            Secondary = new MudBlazor.Utilities.MudColor("#013243"),
            Tertiary = new MudBlazor.Utilities.MudColor("#007BA7"),
            Info = new MudBlazor.Utilities.MudColor("#CF71AF"),
            Success = new MudBlazor.Utilities.MudColor("#3CD070"),
            Warning = new MudBlazor.Utilities.MudColor("#FFCC00"),
            Error = new MudBlazor.Utilities.MudColor("#FF0000"),
            Dark = new MudBlazor.Utilities.MudColor("#010B13"),
        },
        PaletteDark = new MudBlazor.PaletteDark
        {
            AppbarBackground = new MudBlazor.Utilities.MudColor("#1DACD6"),
            Primary = new MudBlazor.Utilities.MudColor("#1DACD6"),
            Secondary = new MudBlazor.Utilities.MudColor("#48D1CC"),
            Tertiary = new MudBlazor.Utilities.MudColor("#007BA7"),
            Info = new MudBlazor.Utilities.MudColor("#884977"),
            Success = new MudBlazor.Utilities.MudColor("#26734A"),
            Warning = new MudBlazor.Utilities.MudColor("#B38B00"),
            Error = new MudBlazor.Utilities.MudColor("#990000"),
            Dark = new MudBlazor.Utilities.MudColor("#000000"),
        },
        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "220px",
            DrawerWidthRight = "220px"
        }
    };
}