@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@* Required *@
<MudThemeProvider Theme="@MyCustomTheme" @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Dense="true" Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudAvatar Size="Size.Small" Class="me-2 bg-light">
            <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
        </MudAvatar>
        <MudText Typo="Typo.h6">
            Travel<span class="brand-accent">nize</span>
        </MudText>
        <MudSpacer />
        <LoginDisplay />
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Docked">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="main-content-wrapper">
        @if (_showProgress)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Tertiary"
                               Size="Size.Small"
                               Class="navigation-progress" />
        }

        <div class="@(_showProgress ? "content-blurred" : null)">
            <Breadcrumb />
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudThemeProvider _mudThemeProvider = default!;

    // Navigation Loading
    private bool _showProgress;
    private DateTime _navLoadingStartUtc;
    private readonly TimeSpan _minLoadingDuration = TimeSpan.FromMilliseconds(350);
    private IDisposable? _locationChangingReg;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    protected override void OnInitialized()
    {
        _locationChangingReg = Navigation.RegisterLocationChangingHandler(LocationChangingAsync);
        Navigation.LocationChanged += NavigationOnLocationChanged;
    }

    private ValueTask LocationChangingAsync(LocationChangingContext ctx)
    {
        StartProgress();
        return ValueTask.CompletedTask;
    }

    private void NavigationOnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = EndProgressAsync();
    }

    private void StartProgress()
    {
        _navLoadingStartUtc = DateTime.UtcNow;
        if (!_showProgress)
        {
            _showProgress = true;
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task EndProgressAsync()
    {
        var elapsed = DateTime.UtcNow - _navLoadingStartUtc;
        var remaining = _minLoadingDuration - elapsed;
        if (remaining > TimeSpan.Zero)
            await Task.Delay(remaining);

        if (_showProgress)
        {
            _showProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = _mudThemeProvider.IsDarkMode;
            await _mudThemeProvider.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
    }

    private Task OnSystemDarkModeChanged(bool newValue)
    {
        _isDarkMode = newValue;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= NavigationOnLocationChanged;
        _locationChangingReg?.Dispose();
    }

    private MudTheme MyCustomTheme = new MudTheme()
    {
        PaletteLight = new MudBlazor.PaletteLight
        {
            AppbarBackground = new MudBlazor.Utilities.MudColor("#37474F"), // Dunkles Grau-Blau
            Primary = new MudBlazor.Utilities.MudColor("#455A64"),          // Dunkler Grau-Blau
            Secondary = new MudBlazor.Utilities.MudColor("#789262"),        // Dezentes Grau-Grün
            Tertiary = new MudBlazor.Utilities.MudColor("#B0BEC5"),         // Helles Grau-Blau
            Success = new MudBlazor.Utilities.MudColor("#8CA6A6"),          // Blaugrau mit Grünanteil
            Dark = new MudBlazor.Utilities.MudColor("#263238"),             // Sehr dunkles Grau-Blau
            Info = new MudBlazor.Utilities.MudColor("#90A4AE"),             // Blaugrau
            Warning = new MudBlazor.Utilities.MudColor("#757575"),          // Mittelgrau
            Error = new MudBlazor.Utilities.MudColor("#37474F"),            // Dunkles Grau-Blau
        },
        PaletteDark = new MudBlazor.PaletteDark
        {
            AppbarBackground = new MudBlazor.Utilities.MudColor("#263238"), // Sehr dunkles Grau-Blau
            Primary = new MudBlazor.Utilities.MudColor("#37474F"),
            Secondary = new MudBlazor.Utilities.MudColor("#455A64"),
            Tertiary = new MudBlazor.Utilities.MudColor("#789262"),
            Success = new MudBlazor.Utilities.MudColor("#8CA6A6"),
            Dark = new MudBlazor.Utilities.MudColor("#11171A"),
            Info = new MudBlazor.Utilities.MudColor("#90A4AE"),
            Warning = new MudBlazor.Utilities.MudColor("#757575"),
            Error = new MudBlazor.Utilities.MudColor("#37474F"),
        },
        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "220px",
            DrawerWidthRight = "220px"
        }
    };

}

<style>
    .main-content-wrapper {
        position: relative;
    }

    .navigation-progress {
        position: absolute;
        z-index: 1100;
    }

    .main-content-wrapper > div {
        transition: filter .300s ease;
    }

    .content-blurred {
        filter: blur(4px);
        transition: none;
        pointer-events: none;
    }
</style>