<MudNavMenu Bordered Class="bg-light bg-opacity-50 text-bg-light" Margin="Margin.None">
    <!-- Hauptnavigation -->
    <MudNavLink Match="NavLinkMatch.All" Href="" Icon="@Icons.Material.Filled.Home">Willkommen</MudNavLink>


    <!-- Trips -->   
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Aktuelle Reise</MudText>
            <MudNavLink Match="NavLinkMatch.All" Href="trips/1" Icon="@Icons.Material.Filled.Hiking">Meine Reise 1</MudNavLink>
            <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Anstehende Reisen</MudText>
            <MudNavLink Match="NavLinkMatch.All" Href="trips/2" Icon="@Icons.Material.Filled.Hiking">Meine Reise 2</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="trips/3" Icon="@Icons.Material.Filled.Hiking">Meine Reise 3</MudNavLink>
        </Authorized>
    </AuthorizeView>
    <!-- Authentifizierung und Profil -->
    <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Konto</MudText>
    <AuthorizeView>
        <NotAuthorized>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/login" Icon="@Icons.Material.Filled.Login">Anmelden</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/register" Icon="@Icons.Material.Filled.PersonAdd">Registrieren</MudNavLink>
        </NotAuthorized>
        <Authorized>
            <MudNavLink Match="NavLinkMatch.All" Href="profile" Icon="@Icons.Material.Filled.Person">Mein Profil</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/logout" Icon="@Icons.Material.Filled.Logout">Abmelden</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>