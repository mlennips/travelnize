@using LIT.Travelnize.Domain.Trips.Queries
@using LIT.Travelnize.Interfaces
@using LIT.Travelnize.Services.Api
@inject TripsApiClient TripsApiClient
@inject IAuthService AuthService;

@code {
    private ListTripsDto[] userTrips = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();

        if (user != null)
        {
            userTrips = await TripsApiClient.GetTripsAsync(user.UserId) ?? [];
        }
        isLoading = false;
    }
}

<MudNavMenu Bordered Margin="Margin.None">
    <!-- Hauptnavigation -->
    <MudNavLink Match="NavLinkMatch.All" Href="" Icon="@Icons.Material.Filled.Home">Willkommen</MudNavLink>

    <!-- Trips -->   
    <AuthorizeView>
        <Authorized>
            <MudNavLink Match="NavLinkMatch.All" Href="trips/1" Icon="@Icons.Material.Filled.Hiking">Reisen</MudNavLink>
            <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Aktuelle Reise</MudText>
            @if (isLoading)
            {
                <MudText Typo="Typo.body2" Class="px-4 py-2">Lade Reisen...</MudText>
            }
            else if (userTrips.Count() == 0)
            {
                <MudText Typo="Typo.body2" Class="px-4 py-2">Keine Reisen gefunden.</MudText>
            }
            else
            {
                var currentTrip = userTrips?.FirstOrDefault();
                if (currentTrip != null)
                {
                    <MudNavLink Match="NavLinkMatch.All" Href=@($"trips/{currentTrip.Id}") Icon="@Icons.Material.Filled.DoubleArrow">@currentTrip.Name</MudNavLink>
                }
                <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Anstehende Reisen</MudText>
                foreach (var trip in userTrips!.Skip(1))
                {
                    <MudNavLink Match="NavLinkMatch.All" Href=@($"trips/{trip.Id}") Icon="@Icons.Material.Filled.CalendarMonth">@trip.Name</MudNavLink>
                }
            }
        </Authorized>
    </AuthorizeView>

    <!-- Authentifizierung und Profil -->
    <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Konto</MudText>
    <AuthorizeView>
        <NotAuthorized>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/login" Icon="@Icons.Material.Filled.Login">Anmelden</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/register" Icon="@Icons.Material.Filled.PersonAdd">Registrieren</MudNavLink>
        </NotAuthorized>
        <Authorized>
            <MudNavLink Match="NavLinkMatch.All" Href="profile" Icon="@Icons.Material.Filled.Person">Mein Profil</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/logout" Icon="@Icons.Material.Filled.Logout">Abmelden</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
