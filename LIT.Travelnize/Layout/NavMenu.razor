@using LIT.Travelnize.Domain.Trips.Queries
@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Interfaces
@inject IAuthService AuthService
@inject TripsState TripsState

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadTripsAsync();
    }

    private async Task LoadTripsAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            await TripsState.LoadTripsAsync(user.UserId);
        }
    }

    private IEnumerable<ListTripsDto> OngoingTrips =>
        TripsState.Trips?.Where(t => t.Status == TripStatus.Ongoing) ?? Enumerable.Empty<ListTripsDto>();

    private IEnumerable<ListTripsDto> UpcomingTrips =>
        TripsState.Trips?.Where(t => t.Status == TripStatus.Upcoming) ?? Enumerable.Empty<ListTripsDto>();
}

<MudNavMenu Bordered Margin="Margin.None">
    <!-- Hauptnavigation -->
    <MudNavLink Match="NavLinkMatch.All" Href="" Icon="@Icons.Material.Filled.Home">Willkommen</MudNavLink>

    <!-- Authentifizierung und Profil -->
    <AuthorizeView>
        <NotAuthorized>
            <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Konto</MudText>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/login" Icon="@Icons.Material.Filled.Login">Anmelden</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/register" Icon="@Icons.Material.Filled.PersonAdd">Registrieren</MudNavLink>
        </NotAuthorized>
        <Authorized>
            <MudNavLink Match="NavLinkMatch.All" Href="trips" Icon="@Icons.Material.Filled.Backpack">Reisen</MudNavLink>
            <!-- Ongoing Trips -->
            @if (TripsState.IsLoading)
            {
                <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Lade Reisen...</MudText>
            }
            else if (OngoingTrips.Any())
            {
                <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Laufende Reisen</MudText>
                @foreach (var trip in OngoingTrips)
                {
                    <MudNavLink Href="@($"/trips/{trip.Id}")" Icon="@Icons.Material.Filled.DoubleArrow">@trip.Name</MudNavLink>
                }
            }

            <!-- Upcoming Trips -->
            @if (!TripsState.IsLoading && UpcomingTrips.Any())
            {
                <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Bevorstehende Reisen</MudText>
                @foreach (var trip in UpcomingTrips)
                {
                    <MudNavLink Href="@($"/trips/{trip.Id}")" Icon="@Icons.Material.Filled.PendingActions">@trip.Name</MudNavLink>
                }
            }

            <MudText Typo="Typo.body2" Class="px-4 py-4 mud-text-secondary fw-normal">Konto</MudText>
            <MudNavLink Match="NavLinkMatch.All" Href="profile" Icon="@Icons.Material.Filled.Person">Mein Profil</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All" Href="authentication/logout" Icon="@Icons.Material.Filled.Logout">Abmelden</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
