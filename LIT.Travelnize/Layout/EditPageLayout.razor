@using LIT.Travelnize.Shared.Dialogs
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@inject IDialogService DialogService
@typeparam TModel

<MudContainer Class="@ContainerClass" MaxWidth="@(MaxWidth)">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <PageHeader Title="@EffectiveTitle"
                        Subtitle="@Subtitle"
                        Actions="HeaderActions"
                        Image="@Image" />
        </MudItem>

        <MudItem xs="12">
            @if (IsLoading)
            {
                <MudStack Row="false" AlignItems="AlignItems.Start" Spacing="2">
                    <MudProgressLinear Indeterminate Color="Color.Primary" Size="Size.Small" />
                </MudStack>
            }
            else if (CurrentEditContext is not null && Model is not null)
            {
                <EditForm EditContext="CurrentEditContext" OnValidSubmit="ValidSubmitAsync">
                    <DataAnnotationsValidator />
                    <MudPaper Class="pa-0" Elevation="0">
                        @if (FormContent is not null)
                        {
                            @FormContent
                        }

                        <MudSpacer />
                        @if (ShowValidationSummary)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="mt-4 pt-4 bg-light bg-opacity-50" Style="margin-bottom: -20px">
                                <ValidationSummary />
                            </MudPaper>
                        }

                        <MudPaper></MudPaper>
                        <MudPaper Elevation="0" Outlined="true" Class="mt-4 bg-light">
                            <MudToolBar Dense="false" Gutters="true">
                                <MudIconButton Icon="@CancelIcon"
                                               Color="Color.Tertiary"
                                               OnClick="Cancel"                                               
                                               title="@CancelText"
                                               Disabled="IsSaving || DisableCancel">
                                </MudIconButton>
                                <MudSpacer />

                                @if(OnDeleteConfirmed.HasDelegate)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   ButtonType="ButtonType.Button"
                                                   OnClick="Delete">
                                    </MudIconButton>
                                    <MudDivider DividerType="DividerType.Middle" Vertical="true" Light="false" />
                                }
                                <MudIconButton Icon="@SaveIcon"
                                               Color="Color.Primary"
                                               Disabled="@IsSaveButtonDisabled"
                                               title="@SaveText"
                                               ButtonType="ButtonType.Submit">
                                </MudIconButton>
                            </MudToolBar>
                            <MudProgressLinear Indeterminate="@IsSaving" Size="Size.Small"  />
                        </MudPaper>
                    </MudPaper>
                </EditForm>
            }
            else if (!string.IsNullOrWhiteSpace(LoadError))
            {
                <MudAlert Severity="Severity.Error" Elevation="0" Variant="Variant.Filled">
                    @LoadError
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // --- NEU: Layout-Variante ---
    [Parameter] public PageLayoutMode Mode { get; set; } = PageLayoutMode.Edit;

    // Layout / Header
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Image { get; set; }
    [Parameter] public IEnumerable<ButtonAction> HeaderActions { get; set; } = default!;

    // Data / State
    [Parameter] public TModel? Model { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? LoadError { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    // Manuelle Steuerung (nur relevant wenn AutoValidate = false)
    [Parameter] public bool CanSave { get; set; } = true;

    [Parameter] public bool DisableCancel { get; set; }

    // Form Inhalt
    [Parameter] public RenderFragment? FormContent { get; set; }
    [Parameter] public bool ShowValidationSummary { get; set; } = false;

    // Actions / Texte
    [Parameter] public string? CancelText { get; set; }
    [Parameter] public string? SaveText { get; set; }
    [Parameter] public RenderFragment? ActionContent { get; set; }

    // Navigation / Cancel
    [Parameter] public string? CancelHref { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    // Submit
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }

    // Validation
    [Parameter] public bool AutoValidate { get; set; } = true;
    [Parameter] public EventCallback<bool> OnValidationChanged { get; set; }

    // Appearance
    [Parameter] public MaxWidth MaxWidth { get; set; } = MaxWidth.Large;
    [Parameter] public string? ContainerClass { get; set; }

    // Extern bereitgestellter EditContext (optional)
    [Parameter] public EditContext? EditContext { get; set; }

    // Delete
    [Parameter] public EventCallback OnDeleteConfirmed { get; set; }


    // --- Texte & Icons je nach Modus ---
    private string EffectiveTitle => !string.IsNullOrWhiteSpace(Title)
        ? Title
        : Mode == PageLayoutMode.Create ? "Anlegen und weiter zur Bearbeitung" : "Speichern und zurück";

    private string EffectiveSaveText => !string.IsNullOrWhiteSpace(SaveText)
        ? SaveText
        : Mode == PageLayoutMode.Create ? "Anlegen" : "Speichern";

    private string EffectiveCancelText => !string.IsNullOrWhiteSpace(CancelText)
        ? CancelText
        : "Abbrechen";

    private string SaveIcon => Mode == PageLayoutMode.Create
        ? Icons.Material.Filled.SaveAs
        : Icons.Material.Outlined.Save;

    private string CancelIcon => Icons.Material.Outlined.Cancel;

    private EditContext? _internalEditContext;
    private EditContext? CurrentEditContext => EditContext ?? _internalEditContext;

    private bool _validationSubscribed;
    private bool _isModelValid;
    private object? _lastModelRef;

    private bool EffectiveCanSave => AutoValidate ? _isModelValid : CanSave;
    private bool IsSaveButtonDisabled => IsSaving || !EffectiveCanSave;

    protected override void OnParametersSet()
    {
        if (Model == null)
        {
            _internalEditContext = null;
            return;
        }

        // Nur neuen internen EditContext erzeugen, wenn keiner extern geliefert wurde
        if (EditContext == null)
        {
            if (_internalEditContext == null || !ReferenceEquals(_lastModelRef, Model))
            {
                _internalEditContext = new EditContext(Model);
                _lastModelRef = Model;
                _validationSubscribed = false; // neu abonnieren
            }
        }

        if (AutoValidate && CurrentEditContext is not null && !_validationSubscribed)
        {
            CurrentEditContext.OnFieldChanged += HandleFieldChanged;
            _validationSubscribed = true;

            // Initial einmal validieren
            Revalidate(triggerEvent: true);
        }

        if (!AutoValidate && _validationSubscribed && CurrentEditContext is not null)
        {
            // AutoValidate aus -> Abonnements entfernen
            CurrentEditContext.OnFieldChanged -= HandleFieldChanged;
            _validationSubscribed = false;
        }
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (AutoValidate)
        {
            Revalidate(triggerEvent: true);
            // Kein explizites StateHasChanged nötig: EditForm löst bereits ein Render aus
        }
    }

    private async Task ValidSubmitAsync()
    {
        IsSaving = true;
        await Task.Delay(500); // Damit der Spinner sichtbar wird
        if (OnValidSubmit.HasDelegate && CurrentEditContext is not null)
        {
            await OnValidSubmit.InvokeAsync(CurrentEditContext);
        }
        IsSaving = false;
    }

    private void Revalidate(bool triggerEvent)
    {
        ShowValidationSummary = false;
        if (CurrentEditContext == null)
        {
            _isModelValid = false;
            return;
        }

        // Nutzt DataAnnotationsValidator (der im EditForm vorhanden ist)
        var newValid = CurrentEditContext.Validate();

        if (newValid != _isModelValid)
        {
            _isModelValid = newValid;
            if (triggerEvent && OnValidationChanged.HasDelegate)
            {
                _ = OnValidationChanged.InvokeAsync(_isModelValid);
            }
            ShowValidationSummary = !_isModelValid;
            CurrentEditContext.NotifyValidationStateChanged();
        }
    }

    private async Task Cancel()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(CancelHref))
        {
            Navigation.NavigateTo(CancelHref);
        }
    }

    private async Task Delete()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };

        var result = await DialogService.ShowMessageBox(
            title: "Löschen bestätigen",
            message: "Soll mit dem Löschen wirklich fortgefahren werden?",
            yesText: "Löschen",
            noText: "Abbrechen",
            options: options
        );

        if (result == true && OnDeleteConfirmed.HasDelegate)
        {
            await OnDeleteConfirmed.InvokeAsync();
        }
    }

    public void Dispose()
    {
        if (_validationSubscribed && CurrentEditContext is not null)
        {
            CurrentEditContext.OnFieldChanged -= HandleFieldChanged;
            _validationSubscribed = false;
        }
    }
}