@page "/trips/{TripId:guid}/travelsegments/create"
@using System.ComponentModel.DataAnnotations
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditPageLayout Mode="PageLayoutMode.Create" TModel="TravelSegmentCreateFormModel"
                Title="@L["TravelSegmentCreate_Title"]"
                Subtitle="@L["TravelSegmentCreate_Subtitle"]"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@LinkHelper.TripLink(TripId)"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="@L["TravelSegment_NameLabel"]"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="@L["TravelSegment_NamePlaceholder"]" />
            </MudItem>
            <MudItem xs="12" sm="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="@L["TravelSegment_DescriptionLabel"]"
                              For="@(()=>FormModel!.Description)"
                              Placeholder="@L["TravelSegment_DescriptionPlaceholder"]"
                              Lines="3" />
            </MudItem>
            <MudItem xs="12">
                <PlanningSlotEdit Model="FormModel!.SlotModel" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }

    internal TravelSegmentCreateFormModel? FormModel;
    internal bool IsLoading;
    internal string? LoadError;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeFormModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = L["TravelSegmentCreate_TripNotFound"];
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeFormModel()
    {
        if (TripsState.SelectedTrip == null) return;

        var start = TripsState.SelectedTrip.TravelSegments.LastOrDefault()?.Slot?.End;
        if (start == null)
        {
            start = TripsState.SelectedTrip.Slot.Start;
        }

        FormModel ??= new TravelSegmentCreateFormModel
        {
            TripId = TripId,
            Name = string.Empty,
            Description = string.Empty,
            SlotModel = new PlanningSlotEdit.PlanningSlotEditModel(new PlanningSlot(start, TripsState.SelectedTrip.Slot.End))
        };
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var slot = FormModel.SlotModel.ToPlanningSlot();

            var command = new AddTravelSegmentCommand(
                FormModel.TripId,
                FormModel.Name!.Trim(),
                FormModel.Description ?? string.Empty,
                slot
            );

            var newId = await TripsState.AddTravelSegmentAsync(FormModel.TripId, command);
            if (newId.HasValue)
            {
                Snackbar.Add(L["TravelSegmentCreate_Success"], Severity.Success);
                Navigation.NavigateTo(LinkHelper.TravelSegmentLinkEdit(TripId, newId.Value));
            }
            else
            {
                Snackbar.Add(L["TravelSegmentCreate_Failed"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["TravelSegmentCreate_Error", ex.Message], Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeFormModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class TravelSegmentCreateFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [StringLength(500, ErrorMessage = "Maximal 500 Zeichen.")]
        public string? Description { get; set; }

        public PlanningSlotEdit.PlanningSlotEditModel SlotModel { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (SlotModel.Start.HasValue && SlotModel.End.HasValue && SlotModel.Start.Value >= SlotModel.End.Value)
            {
                yield return new ValidationResult("Start muss vor Ende liegen.", new[] { nameof(SlotModel.End) });
            }
        }
    }
}