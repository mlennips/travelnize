@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditPageLayout TModel="TravelSegmentEditFormModel"
                Title="@L["TravelSegment_EditTitle"]"
                Subtitle="@L["TravelSegment_EditSubtitle"]"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@LinkHelper.TripLink(TripId)"
                OnValidSubmit="HandleValidSubmit"
                OnDeleteConfirmed="DeleteTravelSegmentAsync">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="@L["TravelSegment_NameLabel"]"
                              For="@(() => FormModel!.Name)"
                              Required="true"
                              Placeholder="@L["TravelSegment_NamePlaceholder"]" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="@L["TravelSegment_DescriptionLabel"]"
                              For="@(() => FormModel!.Description)"
                              Lines="1"
                              Placeholder="@L["TravelSegment_DescriptionPlaceholder"]" />
            </MudItem>
            <MudItem xs="12">
                <PlanningSlotEdit Model="FormModel!.SlotModel" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }

    internal TravelSegmentEditFormModel? FormModel;
    internal bool IsLoading;
    internal string? LoadError;

    private TravelSegmentDto? _segment;
    private DateTime? _tripSlotStart;
    private DateTime? _tripSlotEnd;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = L["Errors_TripNotFound"];
            }
        }
        catch (Exception ex)
        {
            LoadError = L["Errors_Load", ex.Message];
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _tripSlotStart = TripsState.SelectedTrip.Slot.Start;
        _tripSlotEnd = TripsState.SelectedTrip.Slot.End;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = L["Errors_TravelSegmentNotFound"];
            return;
        }

        FormModel = new TravelSegmentEditFormModel(L)
        {
            TripId = TripId,
            SegmentId = TravelSegmentId,
            Name = _segment.Name,
            Description = _segment.Description,
            SlotModel = new PlanningSlotEdit.PlanningSlotEditModel(_segment.Slot)
        };
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var command = new UpdateTravelSegmentCommand(
                FormModel.TripId,
                FormModel.SegmentId,
                FormModel.SlotModel.ToPlanningSlot(),
                FormModel.Name!.Trim(),
                FormModel.Description!.Trim()
            );

            var ok = await TripsState.UpdateTravelSegmentAsync(FormModel.TripId, FormModel.SegmentId, command);
            if (ok)
            {
                Snackbar.Add(string.Format(L["Success_Updated"], L["TravelSegment_Singular"]), Severity.Success);
                Navigation.NavigateTo(LinkHelper.TripLink(TripId));
            }
            else
            {
                Snackbar.Add(L["Errors_UpdateFailed"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Errors_Generic", ex.Message], Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip?.Id == TripId)
            {
                InitializeModel();
            }
            StateHasChanged();
        });
    }

    private async Task DeleteTravelSegmentAsync()
    {
        var result = await TripsState.RemoveTravelSegmentAsync(TripId, TravelSegmentId);
        if (result)
        {
            Snackbar.Add(string.Format(L["Success_Deleted"], L["TravelSegment_Singular"]), Severity.Success);
            Navigation.NavigateTo(LinkHelper.TripLink(TripId));
        }
        else
        {
            Snackbar.Add(L["Errors_DeleteFailed"], Severity.Error);
        }
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class TravelSegmentEditFormModel : IValidatableObject
    {
        private readonly Microsoft.Extensions.Localization.IStringLocalizer<App> _localizer;

        public TravelSegmentEditFormModel(Microsoft.Extensions.Localization.IStringLocalizer<App> localizer)
        {
            _localizer = localizer;
        }

        public Guid TripId { get; set; }
        public Guid SegmentId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(100, ErrorMessage = "Maximal 100 Zeichen.")]
        public string Name { get; set; } = default!;

        [StringLength(500, ErrorMessage = "Maximal 500 Zeichen.")]
        public string? Description { get; set; }

        public PlanningSlotEdit.PlanningSlotEditModel SlotModel { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (SlotModel.Start.HasValue && SlotModel.End.HasValue && SlotModel.End.Value.Date < SlotModel.Start.Value.Date)
            {
                yield return new ValidationResult(_localizer["Errors_EndBeforeStart"], new[] { nameof(SlotModel.End) });
            }
            if (SlotModel.Start.HasValue && SlotModel.End.HasValue && (SlotModel.End.Value.Date - SlotModel.Start.Value.Date).TotalDays > 365)
            {
                yield return new ValidationResult(_localizer["Errors_MaxDuration_TravelSegment"], new[] { nameof(SlotModel.End) });
            }
        }
    }
}