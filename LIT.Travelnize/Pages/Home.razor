@page "/"
@using LIT.Travelnize.Interfaces
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject TripsState TripsState

<PageTitle>Travelnize</PageTitle>

<MudContainer Fixed Class="my-6">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <MudPaper Class="d-flex flex-row mud-width-full py-4" Elevation="0">
                <MudAvatar Size="Size.Large" Class="bg-white mx-4">
                    <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="fw-bold">Travelnize</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-light">
                        Dein smarter Begleiter für die Planung und Organisation deiner nächsten Reise.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem>
            <MudPaper Class="bg-light text-bg-light pa-4" Elevation="0" Outlined="true">
                <MudText>
                    Ob Städtetrip, Weltreise oder Kurzurlaub – mit Travelnize behältst du alles im Blick und kannst schöne Momente planen.
                    Egal, ob du alleine reist oder in einer Gruppe: Die Planung wird zum Kinderspiel.
                    Lege individuelle Reiseabschnitte an und organisiere deine Reise ganz nach deinen Wünschen.
                </MudText>

                @if (!isAuthenticated)
                {
                    <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled" Class="mt-4" DropShadow="false">
                        <MudButton Href="/authentication/login">
                            Jetzt einloggen
                        </MudButton>
                        <MudButton Href="/authentication/register">
                            Oder registrieren
                        </MudButton>
                    </MudButtonGroup>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Elevation="0" Variant="Variant.Filled" Dense="true" Class="mt-4">
                        Willkommen zurück, @firstName! Schön, dass du wieder da bist.
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">Features</MudText>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0"
                      Style="min-height: 180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center bg-primary bg-opacity-75 text-bg-primary">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Reiseplanung</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Plane und verwalte individuelle Reisen mit allen wichtigen Details.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0"
                      Style="min-height: 180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center bg-primary bg-opacity-75 text-bg-primary">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Zielverwaltung</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Behalte den Überblick über deine Reiseziele und Sehenswürdigkeiten.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="0"
                      Style="min-height: 180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center bg-primary bg-opacity-75 text-bg-primary">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Gemeinsam planen</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Plane deinen nächsten Trip gemeinsam mit Freunden oder Familie.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">Statistiken</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Reisen</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Anzahl deiner geplanten und abgeschlossenen Reisen.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Ziele</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Orte und Sehenswürdigkeiten, die du besucht hast.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Mitreisende</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Anzahl der Personen, mit denen du gereist bist.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Community</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Werde Teil der Travelnize-Community und teile deine Erfahrungen.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" Class="text-center">
            <MudDivider />
            <MudText Class="mt-6 text-secondary">
                Viel Spaß beim Entdecken und gemeinsamen Erleben!
            </MudText>
        </MudItem>
    </MudGrid>
</MudContainer>


@code {
    private string? firstName;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.CheckIsAuthenticatedAsync();
        var user = await AuthService.GetCurrentUserAsync();

        if (user != null)
        {
            await TripsState.LoadTripsAsync(user.UserId);
            firstName = user.FirstName;
        }
    }

    protected override Task OnParametersSetAsync()
    {
        return base.OnParametersSetAsync();
    }
}