@page "/"
@using LIT.Travelnize.Helpers
@using LIT.Travelnize.Interfaces
@using LIT.Travelnize.Services.Api
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject TripsState TripsState
@inject HttpClient HttpClient

<PageTitle>Travelnize</PageTitle>

<h3>API Debug</h3>
<p>BaseAddress: @HttpClient.BaseAddress</p>
<p>DefaultProxy: @HttpClient.DefaultProxy</p>

<h3>Navigation Debug</h3>
<p>BaseUri: @NavigationManager.BaseUri</p>
<p>Uri: @NavigationManager.Uri</p>



<MudContainer Class="my-6" MaxWidth="MaxWidth.Large">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <PageHeader Title="Travelnize"
                        Subtitle="Dein smarter Begleiter für die Planung und Organisation deiner nächsten Reise." />
        </MudItem>
        <MudItem>
            <MudPaper Class="bg-light text-bg-light pa-4" Elevation="0" Outlined="true">
                <MudText>
                    Ob Städtetrip, Weltreise oder Kurzurlaub – mit Travelnize behältst du alles im Blick und kannst schöne Momente planen.
                    Egal, ob du alleine reist oder in einer Gruppe: Die Planung wird zum Kinderspiel.
                    Lege individuelle Reiseabschnitte an und organisiere deine Reise ganz nach deinen Wünschen.
                </MudText>

                @if (!isAuthenticated)
                {
                    <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled" Class="mt-4" DropShadow="false">
                        <MudButton Href="/authentication/login">
                            Jetzt einloggen
                        </MudButton>
                        <MudButton Href="/authentication/register">
                            Oder registrieren
                        </MudButton>
                    </MudButtonGroup>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Elevation="0" Variant="Variant.Filled" Dense="true" Class="mt-4">
                        Willkommen zurück, @firstName! Schön, dass du wieder da bist.
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">Features</MudText>
        </MudItem>

        <MudItem xs="12" sm="12" md="6">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-trip">
                <MudIcon Icon="@IconHelper.TripTwoTone" Size="Size.Large" Class="mb-2 text-trip" />
                <MudText Typo="Typo.h6" Class="mb-1 text-trip">Reise</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Die große Bühne deiner Tour: Von der ersten Idee bis zum Heimkommen – hier landet alles, was dein Abenteuer lebendig macht.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-travelsegment">
                <MudIcon Icon="@IconHelper.TravelSegmentTwoTone" Size="Size.Large" Class="mb-2 text-travelsegment" />
                <MudText Typo="Typo.h6" Class="mb-1 text-travelsegment">Reiseabschnitt</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Ein Kapitel deines Trips: ein paar Tage Road, eine Insel, ein Städteblock – verschiebbar, wenn Pläne mal wackeln.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-destination">
                <MudIcon Icon="@IconHelper.DestinationTwoTone" Size="Size.Large" Class="mb-2 text-destination" />
                <MudText Typo="Typo.h6" Class="mb-1 text-destination">Ziel</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Ein Punkt auf der Karte, der dich ruft: Zeitraum rein, kleine Notiz dazu – fertig der Ort, an dem Erinnerungen kleben bleiben.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-accommodation">
                <MudIcon Icon="@IconHelper.AccommodationTwoTone" Size="Size.Large" Class="mb-2 text-accommodation" />
                <MudText Typo="Typo.h6" Class="mb-1 text-accommodation">Unterkunft</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Dein Ruheplatz unterwegs: Adresse griffbereit, Zeiten klar, Kopf frei – kein endloses Suchen in alten Mails mehr.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-activity">
                <MudIcon Icon="@IconHelper.AccommodationTwoTone" Size="Size.Large" Class="mb-2 text-activity" />
                <MudText Typo="Typo.h6" Class="mb-1 text-activity">Aktivität</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Das Salz im Reisealltag: Sonnenaufgang spotten, Markt schlendern, Kajak raus – Zeit festhalten und nicht vergessen.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">Statistiken</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Reisen</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Anzahl deiner geplanten und abgeschlossenen Reisen.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Ziele</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Orte und Sehenswürdigkeiten, die du besucht hast.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Mitreisende</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Anzahl der Personen, mit denen du gereist bist.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">Community</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    Werde Teil der Travelnize-Community und teile deine Erfahrungen.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" Class="text-center">
            <MudDivider />
            <MudText Class="mt-6 text-secondary">
                Viel Spaß beim Entdecken und gemeinsamen Erleben!
            </MudText>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string? firstName;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.CheckIsAuthenticatedAsync();
        var user = await AuthService.GetCurrentUserAsync();

        if (user != null)
        {
            await TripsState.LoadTripsAsync(user.UserId);
            firstName = user.FirstName;
        }
    }

    protected override Task OnParametersSetAsync()
    {
        return base.OnParametersSetAsync();
    }
}