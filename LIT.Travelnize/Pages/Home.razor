@page "/"
@using LIT.Travelnize.Services.Api
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject TripsState TripsState
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <PageHeader Title="@L["Home_WelcomeTitle"]"
                        Subtitle="@L["Home_WelcomeSubtitle"]" />
        </MudItem>
        <MudItem>
            <MudPaper Class="bg-light text-bg-light pa-4" Elevation="0" Outlined="true">
                <MudText>
                    @L["Home_IntroText"]
                </MudText>

                @if (!isAuthenticated)
                {
                    <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled" Class="mt-4" DropShadow="false">
                        <MudButton Href="/authentication/login">
                            @L["Home_LoginNow"]
                        </MudButton>
                        <MudButton Href="/authentication/register">
                            @L["Home_OrRegister"]
                        </MudButton>
                    </MudButtonGroup>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Elevation="0" Variant="Variant.Filled" Dense="true" Class="mt-4">
                        @L["Home_WelcomeBack", firstName ?? ""]
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">@L["Home_Features"]</MudText>
        </MudItem>

        <MudItem xs="12" sm="12" md="6">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-trip">
                <MudIcon Icon="@IconHelper.TripTwoTone" Size="Size.Large" Class="mb-2 text-trip" />
                <MudText Typo="Typo.h6" Class="mb-1 text-trip">@L["Home_Trips"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_TripsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="6">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-travelsegment">
                <MudIcon Icon="@IconHelper.TravelSegmentTwoTone" Size="Size.Large" Class="mb-2 text-travelsegment" />
                <MudText Typo="Typo.h6" Class="mb-1 text-travelsegment">@L["Home_TravelSegments"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_TravelSegmentsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-destination">
                <MudIcon Icon="@IconHelper.DestinationTwoTone" Size="Size.Large" Class="mb-2 text-destination" />
                <MudText Typo="Typo.h6" Class="mb-1 text-destination">@L["Home_Destinations"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_DestinationsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-accommodation">
                <MudIcon Icon="@IconHelper.AccommodationTwoTone" Size="Size.Large" Class="mb-2 text-accommodation" />
                <MudText Typo="Typo.h6" Class="mb-1 text-accommodation">@L["Home_Accommodations"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_AccommodationsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0"
                      Style="min-height:180px;"
                      Class="d-flex flex-column align-center justify-center mud-width-full pa-4 text-center card-activity">
                <MudIcon Icon="@IconHelper.AccommodationTwoTone" Size="Size.Large" Class="mb-2 text-activity" />
                <MudText Typo="Typo.h6" Class="mb-1 text-activity">@L["Home_Activities"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_ActivitiesDesc"]
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.caption">@L["Home_Statistics"]</MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">@L["Home_Trips"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_TripsStatsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">@L["Home_Destinations"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_DestinationsStatsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">@L["Home_Companions"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_CompanionsStatsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Class="d-flex flex-column align-center justify-center mud-width-full py-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                <MudText Typo="Typo.h6" Class="mb-1">@L["Home_Community"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-0">
                    @L["Home_CommunityStatsDesc"]
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" Class="text-center">
            <MudDivider />
            <MudText Class="mt-6 text-secondary">
                @L["Home_EnjoyExploring"]
            </MudText>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private string? firstName;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.CheckIsAuthenticatedAsync();
        var user = await AuthService.GetCurrentUserAsync();

        if (user != null)
        {
            await TripsState.LoadTripsAsync(user.UserId);
            firstName = user.FirstName;
        }
    }

    protected override Task OnParametersSetAsync()
    {
        return base.OnParametersSetAsync();
    }
}