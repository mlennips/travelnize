@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/{DestinationId:guid}/edit"
@using LIT.Travelnize.Domain.External.Wikipedia
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Shared.External
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IDialogService Dialog
@inject IWikipediaApiClient Wikipedia

<PageTitle>Travelnize - Ziel bearbeiten</PageTitle>

<EditPageLayout TModel="DestinationEditFormModel"
                Title="Ziel bearbeiten"
                Subtitle="Passe die Daten deines Reiseziels an."
                ContainerClass="my-6"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@LinkHelper.TripLink(TripId)"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="10">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="Name"
                              For="@(() => FormModel!.Name)"
                              Required="true"
                              Placeholder="Name des Reiseziels" />
            </MudItem>

            <MudItem xs="12" sm="2">
                <MudButtonGroup>
                    <MudButton Disabled="@(string.IsNullOrWhiteSpace(FormModel?.Name))"
                               OnClick="OpenWikipediaDialogAsync"
                               Variant="Variant.Filled"
                               Color="Color.Primary">
                        Aus Wikipedia ergänzen
                    </MudButton>
                </MudButtonGroup>
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="Beschreibung"
                              For="@(() => FormModel!.Description)"
                              Placeholder="Beschreibung"
                              Lines="4" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Adresse</MudText>
            </MudItem>
            <MudItem xs="12">
                <AddressEdit Model="FormModel!.AddressModel" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Koordinaten</MudText>
            </MudItem>
            <MudItem xs="12">
                <CoordinatesEdit Model="FormModel!.CoordinatesModel" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }
    [Parameter] public Guid DestinationId { get; set; }

    private DestinationEditFormModel? FormModel;
    private bool IsLoading;
    private string? LoadError;

    private TravelSegmentDto? _segment;
    private DestinationDto? _destination;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeDestinationModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = "Reise wurde nicht gefunden.";
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeDestinationModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = "Reiseabschnitt wurde nicht gefunden.";
            return;
        }

        _destination = _segment.Destinations.FirstOrDefault(d => d.Id == DestinationId);
        if (_destination == null)
        {
            LoadError = "Ziel wurde nicht gefunden.";
            return;
        }

        var addr = _destination.Location?.Address ?? Address.Empty;

        FormModel = new DestinationEditFormModel
        {
            TripId = TripId,
            SegmentId = TravelSegmentId,
            DestinationId = DestinationId,
            Name = _destination.Name,
            Description = _destination.Description,
            SlotStart = _destination.Slot.Start,
            SlotEnd = _destination.Slot.End,
            Image = _destination.Image?.Source,
            Thumbnail = _destination.Image?.Thumbnail,
            AddressModel = new AddressEdit.AddressEditModel(addr),
            CoordinatesModel = new CoordinatesEdit.CoordinatesEditModel(_destination.Location?.Coordinates)
        };
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var address = new Address(
                FormModel.AddressModel.Line1 ?? string.Empty,
                FormModel.AddressModel.Line2 ?? string.Empty,
                FormModel.AddressModel.Street ?? string.Empty,
                FormModel.AddressModel.HouseNumber ?? string.Empty,
                FormModel.AddressModel.PostalCode ?? string.Empty,
                FormModel.AddressModel.City ?? string.Empty,
                FormModel.AddressModel.Country ?? string.Empty
            );

            var coordinates = new Coordinates
            {
                Latitude = FormModel.CoordinatesModel.Latitude ?? 0,
                Longitude = FormModel.CoordinatesModel.Longitude ?? 0
            };

            var location = new Location(address, coordinates);

            ResourceReference? image = null;
            if (!string.IsNullOrWhiteSpace(FormModel.Image))
            {
                image = ResourceReference.FromUrl(FormModel.Image, FormModel.Image, FormModel.Thumbnail, ResourceKind.Image);
            }

            var command = new UpdateDestinationCommand(
                FormModel.TripId,
                FormModel.SegmentId,
                FormModel.DestinationId,
                FormModel.Name!.Trim(),
                FormModel.Description?.Trim() ?? string.Empty,
                location,
                image,
                null
            );

            var success = await TripsState.UpdateDestinationAsync(FormModel.TripId, command);
            if (success)
            {
                Snackbar.Add("Reise aktualisiert.", Severity.Success);
                Navigation.NavigateTo(LinkHelper.TripLink(TripId));
            }
            else
            {
                Snackbar.Add("Aktualisierung fehlgeschlagen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fehler: " + ex.Message, Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeDestinationModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    private class DestinationEditFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid SegmentId { get; set; }
        public Guid DestinationId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [StringLength(1500, ErrorMessage = "Maximal 1500 Zeichen.")]
        public string? Description { get; set; }

        [StringLength(500)] public string? Image { get; set; }
        [StringLength(500)] public string? Thumbnail { get; set; }

        public DateTime? SlotStart { get; set; }
        public DateTime? SlotEnd { get; set; }

        public AddressEdit.AddressEditModel AddressModel { get; set; } = default!;
        public CoordinatesEdit.CoordinatesEditModel CoordinatesModel { get; set; } = default!;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            return Array.Empty<ValidationResult>();
        }
    }

    private async Task OpenWikipediaDialogAsync()
    {
        if (string.IsNullOrWhiteSpace(FormModel?.Name))
            return;

        var parameters = new DialogParameters
        {
            ["InitialQuery"] = FormModel.Name
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialogRef = await Dialog.ShowAsync<WikipediaSearchDialog>("Wikipedia Suche", parameters, options);
        var result = await dialogRef.Result;

        if (result != null && !result.Canceled && result.Data is WikipediaSummaryDto summary)
        {
            if (string.IsNullOrWhiteSpace(FormModel!.Name))
                FormModel!.Name = summary.Title;
            if (string.IsNullOrWhiteSpace(FormModel.Description) && !string.IsNullOrWhiteSpace(summary.Extract))
                FormModel.Description = summary.ShortDescription + ". " + summary.Extract;
            if (summary.Latitude.HasValue)
                FormModel.CoordinatesModel.Latitude = summary.Latitude;
            if (summary.Longitude.HasValue)
                FormModel.CoordinatesModel.Longitude = summary.Longitude;
            if (string.IsNullOrWhiteSpace(FormModel!.Image))
            {
                FormModel.Image = summary.OriginalImageUrl;
                FormModel.Thumbnail = summary.ThumbnailUrl;
            }           

            Snackbar.Add("Wikipedia-Daten übernommen.", Severity.Success);
            StateHasChanged();
        }
    }
}