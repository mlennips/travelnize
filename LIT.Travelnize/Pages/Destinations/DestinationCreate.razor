@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/create"
@using LIT.Travelnize.Domain.Trips.Commands
@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Domain.Common
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Layout
@using LIT.Travelnize.Components
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Travelnize - Reiseziel hinzufügen</PageTitle>

<EditPageLayout TModel="DestinationCreateFormModel"
                Title="Reiseziel hinzufügen"
                Subtitle="Lege ein neues Reiseziel für deinen Reiseabschnitt an."
                ContainerClass="my-6"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@($"/trips/{TripId}")"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="Name"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="Name des Reiseziels" />
            </MudItem>
            <MudItem xs="12" sm="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="Beschreibung"
                              For="@(()=>FormModel!.Description)"
                              Placeholder="Beschreibung"
                              Lines="3"
                              TextFieldStyle="MudBlazor.TextFieldStyle.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.Start"
                               Label="Start"
                               For="@(()=>FormModel!.Start)"
                               Required="true"
                               MaxDate="FormModel!.End"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.End"
                               Label="Ende"
                               For="@(()=>FormModel!.End)"
                               Required="true"
                               MinDate="FormModel!.Start"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Adresse</MudText>
            </MudItem>
            <MudItem xs="12">
                <AddressEdit Model="AddressModel" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FormModel!.ImageUrl"
                              Label="Bild-URL"
                              For="@(()=>FormModel!.ImageUrl)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FormModel!.WebsiteUrl"
                              Label="Website"
                              For="@(()=>FormModel!.WebsiteUrl)" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }

    internal DestinationCreateFormModel? FormModel;
    internal AddressEdit.AddressEditModel AddressModel { get; set; } = new();
    internal bool IsLoading;
    internal string? LoadError;

    private TravelSegmentDto? _segment;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeFormModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = "Reise wurde nicht gefunden.";
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeFormModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = "Reiseabschnitt wurde nicht gefunden.";
            return;
        }

        var start = _segment.Slot.Start;
        var end = _segment.Slot.End;

        FormModel ??= new DestinationCreateFormModel
        {
            TripId = TripId,
            TravelSegmentId = TravelSegmentId,
            Name = string.Empty,
            Description = string.Empty,
            Start = start,
            End = end,
            Address = new AddressEdit.AddressEditModel()
        };
        AddressModel = FormModel.Address;
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var address = new Address(
                AddressModel.Line1 ?? string.Empty,
                AddressModel.Line2 ?? string.Empty,
                AddressModel.Street ?? string.Empty,
                AddressModel.HouseNumber ?? string.Empty,
                AddressModel.PostalCode ?? string.Empty,
                AddressModel.City ?? string.Empty,
                AddressModel.Country ?? string.Empty
            );
            var location = new Location(address, Coordinates.Empty);

            ResourceReference? image = !string.IsNullOrWhiteSpace(FormModel.ImageUrl)
                ? ResourceReference.FromUrl(FormModel.ImageUrl, FormModel.ImageUrl, forceKind: ResourceKind.Image)
                : null;
            ResourceReference? website = !string.IsNullOrWhiteSpace(FormModel.WebsiteUrl)
                ? ResourceReference.FromUrl(FormModel.WebsiteUrl, FormModel.WebsiteUrl, forceKind: ResourceKind.Website)
                : null;

            var slot = PlanningSlot.Create(FormModel.Start, FormModel.End);

            var command = new AddDestinationCommand(
                FormModel.TripId,
                FormModel.TravelSegmentId,
                FormModel.Name!.Trim(),
                FormModel.Description ?? string.Empty,
                location,
                slot
            );

            var newId = await TripsState.AddDestinationAsync(FormModel.TripId, FormModel.TravelSegmentId, command);
            if (newId.HasValue)
            {
                Snackbar.Add("Reiseziel erstellt.", Severity.Success);
                Navigation.NavigateTo($"/trips/{TripId}");
            }
            else
            {
                Snackbar.Add("Erstellung fehlgeschlagen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fehler: " + ex.Message, Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeFormModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class DestinationCreateFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid TravelSegmentId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [StringLength(500, ErrorMessage = "Maximal 500 Zeichen.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Start ist erforderlich.")]
        public DateTime? Start { get; set; }

        [Required(ErrorMessage = "Ende ist erforderlich.")]
        public DateTime? End { get; set; }

        public AddressEdit.AddressEditModel Address { get; set; } = new();

        [StringLength(500)] public string? ImageUrl { get; set; }
        [StringLength(500)] public string? WebsiteUrl { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Start.HasValue && End.HasValue && Start.Value >= End.Value)
            {
                yield return new ValidationResult("Start muss vor Ende liegen.", new[] { nameof(End) });
            }
        }
    }
}