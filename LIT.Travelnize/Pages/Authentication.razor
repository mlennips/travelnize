@page "/authentication/{action}"
@page "/authentication"
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Auth
@using LIT.Travelnize.Interfaces
@using LIT.Travelnize.Services.Api
@using LIT.Travelnize.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using MudBlazor
@inject AuthApiClient AuthApiClient
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack Spacing="6">
        <PageHeader Title="@L["Auth_Title"]"
                    Subtitle="@L["Auth_Subtitle"]"
                    Image="icon-192.png" />
        <MudPaper Elevation="0" Outlined="false">
            <AuthorizeView>
                <Authorized Context="authContext">
                    <MudTabs>
                        <MudTabPanel Text="@L["Auth_TabLogout"]">
                            <MudText Class="my-4">
                                @L["Auth_LoggedInAs"] <b>@authContext.User.Identity?.Name</b>
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Logout())">@L["Auth_Logout"]</MudButton>
                        </MudTabPanel>
                    </MudTabs>
                </Authorized>
                <NotAuthorized Context="notAuthContext">
                    <MudTabs>
                        <MudTabPanel Text="@L["Auth_TabLogin"]">
                            <MudForm @ref="loginForm" Class="my-4">
                                <MudGrid Spacing="4">
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="LoginModel.EmailOrUserName" Label="@L["Auth_EmailLabel"]" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="LoginModel.Password" Label="@L["Auth_PasswordLabel"]" InputType="InputType.Password" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitLoginAsync">@L["Auth_Login"]</MudButton>
                                        @if (IsDevEnvironment)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="ml-2" OnClick="FillDemoAndLogin">@L["Auth_Demo"]</MudButton>
                                        }
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudText Color="Color.Error">@loginError</MudText>
                                        <MudDivider Class="my-4" />
                                        <MudText Typo="Typo.caption" Class="text-center d-block">
                                            @L["Auth_NoAccount"]
                                        </MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudForm>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Auth_TabRegister"]">
                            <MudForm @ref="registerForm" Class="my-4">
                                <MudGrid Spacing="4">
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="RegisterModel.Email" Label="@L["Auth_EmailLabel"]" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="RegisterModel.Password" Label="@L["Auth_PasswordLabel"]" InputType="InputType.Password" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="RegisterModel.ConfirmPassword" Label="@L["Auth_ConfirmPasswordLabel"]" InputType="InputType.Password" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="RegisterModel.FirstName" Label="@L["Auth_FirstNameLabel"]" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="RegisterModel.LastName" Label="@L["Auth_LastNameLabel"]" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitRegisterAsync">@L["Auth_Register"]</MudButton>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudText Color="Color.Error">@registerError</MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudForm>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Auth_TabForgotPassword"]">
                            <MudForm @ref="forgotPasswordForm" Class="my-4">
                                <MudGrid Spacing="4">
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="ForgotPasswordModel.EmailOrUserName" Label="@L["Auth_EmailLabel"]" FullWidth="true" Required="true" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForgotPasswordAsync">@L["Auth_RequestNewPassword"]</MudButton>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudText Color="Color.Error">@forgotPasswordError</MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudForm>
                        </MudTabPanel>
                    </MudTabs>
                </NotAuthorized>
            </AuthorizeView>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] IAuthService AuthService { get; set; } = default!;

    [Parameter] public string? Action { get; set; }

    private MudForm? loginForm;
    private MudForm? forgotPasswordForm;
    private MudForm? registerForm;
    private string? loginError;
    private string? forgotPasswordError;
    private string? registerError;

    private LoginCommand LoginModel { get; set; } = new();
    private RegisterCommand RegisterModel { get; set; } = new();
    private ForgotPasswordCommand ForgotPasswordModel { get; set; } = new();

    private bool IsDevEnvironment =>
#if DEBUG
        true;
#else
        false;
#endif

    private async Task FillDemoAndLogin()
    {
        LoginModel.EmailOrUserName = "demo@travelnize.de";
        LoginModel.Password = "Demo%2025";
        StateHasChanged(); // UI-Update anstoßen
        await Task.Delay(1); // Einen Render-Zyklus abwarten
        await SubmitLoginAsync();
    }

    private async Task SubmitLoginAsync()
    {
        loginError = null;
        if (loginForm is not null)
        {
            await loginForm.Validate();
            if (loginForm.IsValid)
            {
                var isAuthSuccess = await AuthService.LoginAsync(LoginModel.EmailOrUserName, LoginModel.Password);
                if (isAuthSuccess)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    loginError = L["Errors_LoginFailed"];
                }
            }
            else
            {
                loginError = L["Errors_Validation"];
            }
        }
    }

    private async Task SubmitForgotPasswordAsync()
    {
        forgotPasswordError = null;
        if (forgotPasswordForm is not null)
        {
            await forgotPasswordForm.Validate();
            if (forgotPasswordForm.IsValid)
            {
                var response = await AuthApiClient.ForgotPasswordAsync(ForgotPasswordModel);
                if (response.IsSuccessStatusCode)
                {
                    Navigation.NavigateTo("/authentication/login");
                }
                else
                {
                    forgotPasswordError = L["Errors_PasswordResetFailed"];
                }
            }
            else
            {
                forgotPasswordError = L["Errors_Validation"];
            }
        }
    }
    private async Task SubmitRegisterAsync()
    {
        registerError = null;
        if (registerForm is not null)
        {
            await registerForm.Validate();
            if (registerForm.IsValid)
            {
                var response = await AuthApiClient.RegisterAsync(RegisterModel!);
                if (response != null && response.IsSuccessStatusCode)
                {
                    LoginModel = new LoginCommand
                    {
                        EmailOrUserName = RegisterModel!.Email,
                        Password = RegisterModel.Password
                    };
                    await SubmitLoginAsync();
                }
                else
                {
                    registerError = L["Errors_RegisterFailed"];
                }
            }
            else
            {
                registerError = L["Errors_Validation"];
            }
        }
    }

    private async Task Logout()
    {
        if (await AuthService.LogoutAsync())
            Navigation.NavigateTo("/");
    }
}
