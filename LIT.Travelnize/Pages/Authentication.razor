@page "/authentication/{action}"
@page "/authentication"
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Auth
@using LIT.Travelnize.Interfaces
@using LIT.Travelnize.Services.Api
@using LIT.Travelnize.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using MudBlazor

@inject AuthApiClient AuthApiClient

<AuthorizeView>
    <Authorized Context="authContext">
        <MudContainer Fixed Class="my-6">
            <MudTabs>
                <MudTabPanel Text="Abmelden">
                    <MudText Class="my-4">
                        Du bist angemeldet als @authContext.User.Identity?.Name
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Logout())">Abmelden</MudButton>
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </Authorized>
    <NotAuthorized Context="notAuthContext">
        <MudContainer Fixed Class="my-6">
            <MudTabs>
                <MudTabPanel Text="Login">
                    <MudForm @ref="loginMudForm" Class="my-4">
                        <MudGrid Spacing="4">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="LoginModel.EmailOrUserName" Label="E-Mail" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="LoginModel.Password" Label="Passwort" InputType="InputType.Password" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitLoginAsync">Anmelden</MudButton>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Color="Color.Error">@loginError</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudTabPanel>
                <MudTabPanel Text="Registrieren">
                    <MudForm @ref="registerMudForm" Class="my-4">
                        <MudGrid Spacing="4">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="RegisterModel.Email" Label="E-Mail" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="RegisterModel.Password" Label="Passwort" InputType="InputType.Password" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="RegisterModel.ConfirmPassword" Label="Passwort bestätigen" InputType="InputType.Password" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="RegisterModel.FirstName" Label="Vorname" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="RegisterModel.LastName" Label="Nachname" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitRegisterAsync">Registrieren</MudButton>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Color="Color.Error">@registerError</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudTabPanel>
                <MudTabPanel Text="Passwort vergessen">
                    <MudForm @ref="forgotPasswordMudForm" Class="my-4">
                        <MudGrid Spacing="4">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="ForgotPasswordModel.EmailOrUserName" Label="E-Mail" FullWidth="true" Required="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitForgotPasswordAsync">Neues Passwort anfordern</MudButton>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Color="Color.Error">@forgotPasswordError</MudText>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                </MudTabPanel>
            </MudTabs>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] IAuthService AuthService { get; set; } = default!;

    private MudForm? loginMudForm;
    private MudForm? forgotPasswordMudForm;
    private MudForm? registerMudForm;
    private string? loginError;
    private string? forgotPasswordError;
    private string? registerError;

    private LoginCommand LoginModel { get; set; } = new();
    private RegisterCommand RegisterModel { get; set; } = new();
    private ForgotPasswordCommand ForgotPasswordModel { get; set; } = new();

    private async Task SubmitLoginAsync()
    {
        loginError = null;
        if (loginMudForm is not null)
        {
            await loginMudForm.Validate();
            if (loginMudForm.IsValid)
            {
                var isAuthSuccess = await AuthService.LoginAsync(LoginModel.EmailOrUserName, LoginModel.Password);
                if (isAuthSuccess)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    loginError = "Login fehlgeschlagen. Bitte überprüfe deine Eingaben.";
                }
            }
            else
            {
                loginError = "Bitte fülle alle Felder korrekt aus.";
            }
        }
    }

    private async Task SubmitForgotPasswordAsync()
    {
        forgotPasswordError = null;
        if (forgotPasswordMudForm is not null)
        {
            await forgotPasswordMudForm.Validate();
            if (forgotPasswordMudForm.IsValid)
            {
                var response = await AuthApiClient.ForgotPasswordAsync(ForgotPasswordModel);
                if (response.IsSuccessStatusCode)
                {
                    Navigation.NavigateTo("/authentication/login");
                }
                else
                {
                    loginError = "Passwort zurücksetzen fehlgeschlagen. Bitte überprüfe deine Eingaben.";
                }
            }
            else
            {
                loginError = "Bitte fülle alle Felder korrekt aus.";
            }
        }
    }
    private async Task SubmitRegisterAsync()
    {
        registerError = null;
        if (registerMudForm is not null)
        {
            await registerMudForm.Validate();
            if (registerMudForm.IsValid)
            {
                var response = await AuthApiClient.RegisterAsync(RegisterModel!);
                if (response != null && response.IsSuccessStatusCode)
                {
                    LoginModel = new LoginCommand
                    {
                        EmailOrUserName = RegisterModel!.Email,
                        Password = RegisterModel.Password
                    };
                    await SubmitLoginAsync();
                }
                else
                {
                    registerError = "Registrierung fehlgeschlagen. Bitte versuche es erneut.";
                }
            }
            else
            {
                registerError = "Bitte fülle alle Felder korrekt aus.";
            }
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    [Parameter] public string? Action { get; set; }
}
