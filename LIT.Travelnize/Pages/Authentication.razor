@page "/authentication/{action}"
@page "/authentication"

@using LIT.Travelnize.Shared.Auth
@using LIT.Travelnize.Utils.Api
@using LIT.Travelnize.Utils.Auth
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthApiClient AuthApiClient

<AuthorizeView>
    <Authorized Context="authContext">
        <h3>Logout</h3>
        <p>Du bist angemeldet als @authContext.User.Identity?.Name</p>
        <button @onclick="Logout">Abmelden</button>
    </Authorized>
    <NotAuthorized Context="notAuthContext">
        <h3>Login</h3>
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" Context="loginFormContext">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <label for="login-email">E-Mail:</label>
                <InputText id="login-email" @bind-Value="loginModel.EmailOrUserName" />
            </div>
            <div>
                <label for="login-password">Passwort:</label>
                <InputText id="login-password" type="password" @bind-Value="loginModel.Password" />
            </div>
            <button type="submit">Anmelden</button>
        </EditForm>

        <h3>Register</h3>
        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" Context="registerFormContext">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <label for="register-email">E-Mail:</label>
                <InputText id="register-email" @bind-Value="registerModel.Email" />
            </div>
            <div>
                <label for="register-password">Passwort:</label>
                <InputText id="register-password" type="password" @bind-Value="registerModel.Password" />
            </div>
            <div>
                <label for="register-confirm">Passwort bestätigen:</label>
                <InputText id="register-confirm" type="password" @bind-Value="registerModel.ConfirmPassword" />
            </div>
            <div>
                <label for="register-firstname">Vorname</label>
                <InputText id="register-firstname" @bind-Value="registerModel.FirstName" />
            </div>
            <div>
                <label for="register-lastname">Nachname</label>
                <InputText id="register-lastname" @bind-Value="registerModel.LastName" />
            </div>

            <button type="submit">Registrieren</button>
        </EditForm>
    </NotAuthorized>
</AuthorizeView>

<h1>@Action</h1>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private LoginCommand loginModel = new();
    private RegisterCommand registerModel = new();

    private async Task HandleLogin()
    {
        var isAuthSuccess = await ((JwtAuthenticationStateProvider)AuthProvider).LoginAsync(loginModel.EmailOrUserName, loginModel.Password);
        if (isAuthSuccess)
        {
            Navigation.NavigateTo("/");
        };
    }

    private async Task HandleRegister()
    {
        var response = await AuthApiClient.RegisterAsync(registerModel);
        if (response != null && response.IsSuccessStatusCode)
        {
            loginModel = new LoginCommand
            {
                EmailOrUserName = registerModel.Email,
                Password = registerModel.Password
            };
            await HandleLogin();
        }
    }

    private async Task Logout()
    {
        await ((JwtAuthenticationStateProvider)AuthProvider).LogoutAsync();
        Navigation.NavigateTo("/");
    }
}

@code{
    [Parameter] public string? Action { get; set; }
}
