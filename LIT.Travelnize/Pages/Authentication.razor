@page "/authentication/{action}"
@page "/authentication"
@using System.ComponentModel.DataAnnotations

@using LIT.Travelnize.Shared.Auth
@using LIT.Travelnize.Utils.Api
@using LIT.Travelnize.Utils.Auth
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject AuthApiClient AuthApiClient

<AuthorizeView>
    <Authorized Context="authContext">
        <MudContainer MaxWidth="MaxWidth.Small" Class="mx-1 mt-6">
            <MudPaper Elevation="2" Class="p-6">
                <h3>Logout</h3>
                <p>Du bist angemeldet als @authContext.User.Identity?.Name</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Logout())">Abmelden</MudButton>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized Context="notAuthContext">
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-2">
            <MudPaper Elevation="1" Class="pa-2">
                <MudTabs>
                    <MudTabPanel Text="Login">
                        <MudForm @ref="loginMudForm">
                            <MudGrid Spacing="4">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="LoginModel.EmailOrUserName" Label="E-Mail" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="LoginModel.Password" Label="Passwort" InputType="InputType.Password" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitLoginAsync">Anmelden</MudButton>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Color="Color.Error">@loginError</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudForm>
                    </MudTabPanel>
                    <MudTabPanel Text="Registrieren">
                        <MudForm @ref="registerMudForm">
                            <MudGrid Spacing="4">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="RegisterModel.Email" Label="E-Mail" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="RegisterModel.Password" Label="Passwort" InputType="InputType.Password" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="RegisterModel.ConfirmPassword" Label="Passwort bestätigen" InputType="InputType.Password" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="RegisterModel.FirstName" Label="Vorname" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="RegisterModel.LastName" Label="Nachname" FullWidth="true" Required="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitRegisterAsync">Registrieren</MudButton>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudText Color="Color.Error">@registerError</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudForm>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;
    [Inject] AuthenticationStateProvider AuthProvider { get; set; } = default!;

    private MudForm? loginMudForm;
    private MudForm? registerMudForm;
    private string? loginError;
    private string? registerError;

    private LoginCommand LoginModel { get; set; } = new();
    private RegisterCommand RegisterModel { get; set; } = new();

    private async Task SubmitLoginAsync()
    {
        loginError = null;
        if (loginMudForm is not null)
        {
            await loginMudForm.Validate();
            if (loginMudForm.IsValid)
            {
                var isAuthSuccess = await ((JwtAuthenticationStateProvider)AuthProvider).LoginAsync(LoginModel.EmailOrUserName, LoginModel.Password);
                if (isAuthSuccess)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    loginError = "Login fehlgeschlagen. Bitte überprüfe deine Eingaben.";
                }
            }
            else
            {
                loginError = "Bitte fülle alle Felder korrekt aus.";
            }
        }
    }

    private async Task SubmitRegisterAsync()
    {
        registerError = null;
        if (registerMudForm is not null)
        {
            await registerMudForm.Validate();
            if (registerMudForm.IsValid)
            {
                var response = await AuthApiClient.RegisterAsync(RegisterModel!);
                if (response != null && response.IsSuccessStatusCode)
                {
                    LoginModel = new LoginCommand
                    {
                        EmailOrUserName = RegisterModel!.Email,
                        Password = RegisterModel.Password
                    };
                    await SubmitLoginAsync();
                }
                else
                {
                    registerError = "Registrierung fehlgeschlagen. Bitte versuche es erneut.";
                }
            }
            else
            {
                registerError = "Bitte fülle alle Felder korrekt aus.";
            }
        }
    }

    private async Task Logout()
    {
        await ((JwtAuthenticationStateProvider)AuthProvider).LogoutAsync();
        Navigation.NavigateTo("/");
    }

    [Parameter] public string? Action { get; set; }
}
