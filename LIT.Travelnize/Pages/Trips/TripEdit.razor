@page "/trips/{TripId:guid}/edit"
@using LIT.Travelnize.Domain.Trips.Queries
@using LIT.Travelnize.Domain.Trips.Commands
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Shared.Forms
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Travelnize - Reise bearbeiten</PageTitle>

<EditPageLayout TModel="TripEditFormModel"
                Title="Reise bearbeiten"
                Subtitle="Passe die Basisdaten deiner Reise an."
                ContainerClass="my-6"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                AutoValidate="true"
                CancelHref="@($"/trips/{TripId}")"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="Name"
                              For="@(() => FormModel!.Name)"
                              Required="true"
                              Placeholder="Titel der Reise" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="Beschreibung"
                              For="@(() => FormModel!.Description)"
                              Placeholder="Kurze Beschreibung"
                              Lines="4"
                              TextArea="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.TravelStart"
                               Label="Startdatum"
                               For="@(() => FormModel!.TravelStart)"
                               MaxDate="@FormModel!.TravelEnd"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.TravelEnd"
                               Label="Enddatum"
                               For="@(() => FormModel!.TravelEnd)"
                               MinDate="@FormModel!.TravelStart"
                               Clearable="true" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }

    private TripEditFormModel? FormModel;
    private bool IsLoading;
    private string? LoadError;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadAsync();
        }
        else
        {
            InitializeForm(TripsState.SelectedTrip);
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);

            if (TripsState.SelectedTrip == null)
            {
                LoadError = "Reise wurde nicht gefunden.";
            }
            else
            {
                InitializeForm(TripsState.SelectedTrip);
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeForm(GetTripResponse trip)
    {
        LoadError = null;

        FormModel = new TripEditFormModel
        {
            TripId = trip.Id,
            Name = trip.Name,
            Description = trip.Description,
            TravelStart = trip.Slot.Start?.Date,
            TravelEnd = trip.Slot.End?.Date
        };
        // Keine manuelle ValidateModel mehr nötig (AutoValidate übernimmt)
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var command = new UpdateTripCommand(
                FormModel.TripId,
                FormModel.Name!.Trim(),
                FormModel.Description?.Trim() ?? string.Empty,
                FormModel.TravelStart!.Value,
                FormModel.TravelEnd!.Value
            );

            var ok = await TripsState.UpdateTripAsync(FormModel.TripId, command);
            if (ok)
            {
                Snackbar.Add("Reise aktualisiert.", Severity.Success);
                Navigation.NavigateTo($"/trips/{TripId}", forceLoad: false);
            }
            else
            {
                Snackbar.Add("Aktualisierung fehlgeschlagen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fehler: " + ex.Message, Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeForm(TripsState.SelectedTrip);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    private class TripEditFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [StringLength(1500, ErrorMessage = "Maximal 1500 Zeichen.")]
        public string? Description { get; set; }

        public DateTime? TravelStart { get; set; }

        public DateTime? TravelEnd { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (TravelStart != null && TravelEnd == null)
            {
                yield return new ValidationResult("Enddatum darf nicht leer sein", new[] { nameof(TravelEnd) });
            }
            if (TravelStart == null && TravelEnd != null)
            {
                yield return new ValidationResult("Startdatum darf nicht leer sein", new[] { nameof(TravelStart) });
            }

            if (TravelStart.HasValue && TravelEnd.HasValue)
            {
                if (TravelEnd.Value.Date < TravelStart.Value.Date)
                {
                    yield return new ValidationResult("Enddatum darf nicht vor dem Startdatum liegen.", new[] { nameof(TravelEnd) });
                }
                if ((TravelEnd.Value.Date - TravelStart.Value.Date).TotalDays > 365)
                {
                    yield return new ValidationResult("Reise darf maximal 365 Tage dauern.", new[] { nameof(TravelEnd) });
                }
            }
        }
    }
}