@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.Queries
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (Trip is null)
{
    <MudText Typo="Typo.caption">@L["TripParticipantsTab_NoData"]</MudText>
}
else
{
    <MudStack Spacing="2" Class="mx-2 my-6">
        <MudSimpleTable Dense="false" Hover="true" Elevation="2" Class="width-full">
            <thead>
                <tr>
                    <th style="width:56px;"></th>
                    <th>@L["TripParticipantsTab_NameLabel"]</th>
                    <th>@L["TripParticipantsTab_RoleLabel"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Trip.Participants.OrderBy(p => p.Name))
            {
                <tr>
                    <td>
                        <ParticipantAvatar Participant="@p" Size="Size.Medium" />
                    </td>
                    <td>@p.Name</td>
                    <td>@p.PermissionLevel</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudStack>
}

@code {
    [Parameter] public GetTripResponse? Trip { get; set; }
}