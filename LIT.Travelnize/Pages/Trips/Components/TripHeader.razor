@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Helpers

<MudPaper Class="bg-light text-bg-light pa-4" Elevation="0" Outlined="false" Style="position: relative;">
    <MudText Style="position: absolute; top: -17px; right: 10px;"
             Color="Color.Dark"
             Class="text-end opacity-25 fw-bolder">
        <PlanningSlotDisplay Slot="@Trip?.Slot" Typo="Typo.h6"></PlanningSlotDisplay>
    </MudText>
    <MudText Color="Color.Secondary" Class="opacity-75">
        @Trip?.Description
        <MudLink Href="@LinkHelper.TripLinkEdit(TripId)" Typo="Typo.caption">
            (bearbeiten)
        </MudLink>
    </MudText>
    <MudChipSet T="string" Size="Size.Medium" IconColor="Color.Default" ReadOnly>
        <MudChip Icon="@Icons.Material.Filled.FlightTakeoff" Color="Color.Tertiary">@Trip?.Slot.Start?.ToLongDateString()</MudChip>
        <MudChip Icon="@Icons.Material.Filled.FlightLand" Color="Color.Tertiary">@Trip?.Slot.End?.ToLongDateString()</MudChip>
        @if (Trip is not null)
        {
            if (Trip.Status == TripStatus.Pending)
            {
                <MudChip Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Tertiary">@Trip.Slot.TotalDaysInclusive Tage</MudChip>
            }
            else if (Trip.Status == TripStatus.Upcoming)
            {
                <MudChip Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Tertiary">@Trip.Slot.DaysUntilStart Tage</MudChip>
                <MudChip Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Tertiary">@Trip.Slot.TotalDaysInclusive Tage</MudChip>
            }
            else if (Trip.Status == TripStatus.Ongoing)
            {
                <MudChip Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Success">
                    @Trip.Slot.ActiveDays/@Trip.Slot.TotalDaysInclusive Tage
                </MudChip>
            }
            else if (Trip.Status == TripStatus.Past)
            {
                <MudChip Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Tertiary">@Trip.Slot.TotalDaysInclusive Tage</MudChip>
            }
            <MudChip Icon="@Icons.Material.Filled.People" Color="Color.Tertiary">@Trip.Participants.Count Teilnehmer</MudChip>
        }
    </MudChipSet>
    <MudAvatarGroup Spacing="2"
                    Max="5"
                    Style="position: absolute; bottom: -24px; right: 10px;">
        @if (Trip is not null)
        {
            @foreach (var participant in Trip.Participants.OrderBy(p => Guid.NewGuid()))
            {
                <ParticipantAvatar Participant="@participant" Href="@LinkHelper.TripLink(TripId, "participants")" />
            }
        }
    </MudAvatarGroup>
</MudPaper>

@code {
    [Parameter, EditorRequired] public GetTripResponse? Trip { get; set; }
    [Parameter, EditorRequired] public Guid TripId { get; set; }
}