@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.Queries
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (Trip?.Transportations == null || !Trip.Transportations.Any())
{
    <MudText Typo="Typo.caption">@L["Errors_NoData"]</MudText>
}
else
{
    <MudStack Class="my-6" Spacing="4">
        @foreach (var group in Trip.Transportations
            .Where(t => t.Traveltime?.Start != null)
            .GroupBy(t => t.Traveltime.Start?.Date!)
            .OrderBy(g => g.Key))
        {
            <MudPaper Elevation="0">
                <MudText Typo="Typo.caption" Class="mb-2 opacity-25 w-100 text-center" HtmlTag="div" Align="Align.Center" GutterBottom>
                    @group.Key!.Value.ToLongDateString()
                </MudText>
                <MudStack Spacing="2">
                    @foreach (var transportation in group.OrderBy(t => t.Traveltime.Start))
                    {
                        <MudPaper Elevation="8" Class="pa-4">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudStack Spacing="2">
                                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                            <MudLink Href="@LinkHelper.TransportationLinkEdit(Trip.Id, transportation.Id)">
                                                <MudText Typo="Typo.subtitle1" Class="fw-bold">@transportation.Name</MudText>
                                             </MudLink>
                                            
                                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@IconHelper.GetIconForTransportationType(transportation.Type)">
                                                @((@transportation.Type.Value + " " + @transportation.Identifier).Trim())
                                            </MudChip>
                                            @if (!string.IsNullOrWhiteSpace(transportation.RouteWebsite?.Source))
                                            {
                                                <MudChip T="ResourceReference" Size="Size.Small" Href="@transportation.RouteWebsite.Source" Icon="@MudBlazor.Icons.Material.Filled.Route" Target="_blank">
                                                    @transportation.RouteWebsite.Name
                                                </MudChip>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.body2">@transportation.Description</MudText>
                                        <MudStack Row >
                                            <MudText Typo="Typo.caption">
                                                @L["Transportation_Departure"]:
                                            </MudText>
                                            <MudText Typo="Typo.caption">
                                                @transportation.Traveltime.Start?.ToLongDateString() @transportation.Traveltime.Start?.ToShortTimeString()
                                                <br />@transportation.Departure.Address?.ToString()
                                            </MudText>
                                        </MudStack>

                                        <MudStack Row>
                                            <MudText Typo="Typo.caption">
                                                @L["Transportation_Arrival"]:
                                            </MudText>
                                            <MudText Typo="Typo.caption">
                                                @transportation.Traveltime.End?.ToLongDateString() @transportation.Traveltime.End?.ToShortTimeString()
                                                <br />@transportation.Arrival.Address?.ToString()
                                            </MudText>
                                        </MudStack>

                                        <MudStack Row>
                                            <MudText Typo="Typo.caption">
                                                <b>@L["Transportation_PlannedTransferDuration"]:</b>
                                                @transportation.Traveltime.Duration.Hours.ToString("00") @L["Common_Hours"] @transportation.Traveltime.Duration.Minutes.ToString("00") @L["Common_Minutes"]
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTimeline>
                                        <MudTimelineItem Size="Size.Medium" Elevation="0" TimelineAlign="TimelineAlign.End" Class="align-items-center">
                                            <ItemDot>
                                                <MudIcon Size="Size.Small" Icon="@MudBlazor.Icons.Material.Sharp.Hail" Color="Color.Secondary" />
                                            </ItemDot>
                                            <ItemContent>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption">@transportation.Traveltime.Start?.ToShortDateString()</MudText>
                                                    <MudText Typo="Typo.caption" Class="fw-bold">@transportation.Traveltime.Start?.ToShortTimeString()</MudText>
                                                </MudStack>
                                            </ItemContent>
                                            <ItemOpposite>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption">@L["Transportation_Departure"]</MudText>
                                                    <MudText Typo="Typo.caption" 
                                                             Class="fw-bold"
                                                             title="@transportation.Departure.Address?.ToString()">
                                                        @transportation.Departure.Address?.Line1.ToString()
                                                    </MudText>
                                                </MudStack>
                                            </ItemOpposite>
                                        </MudTimelineItem>
                                        <MudTimelineItem Size="Size.Large" Elevation="0" TimelineAlign="TimelineAlign.Default">
                                            <ItemDot>
                                                <MudIcon Size="Size.Medium" Icon="@IconHelper.GetIconForTransportationType(transportation.Type)" />
                                            </ItemDot>
                                            <ItemContent>
                                                @{
                                                    var targetDestination = GetTargetDestination(transportation);
                                                    if (targetDestination != null)
                                                    {
                                                        <MudStack Row Spacing="0" Class="justify-content-end">
                                                            <MudText Typo="Typo.caption" Align="Align.Right">@L["Transportation_TransferTo"] @targetDestination.Name</MudText>
                                                        </MudStack>
                                                    }
                                                }
                                            </ItemContent>
                                            <ItemOpposite>
                                            </ItemOpposite>
                                        </MudTimelineItem>
                                        <MudTimelineItem Size="Size.Medium" Variant="Variant.Outlined" Elevation="0" TimelineAlign="TimelineAlign.End" Class="align-items-center">
                                            <ItemDot>
                                                <MudIcon Size="Size.Small" Icon="@MudBlazor.Icons.Material.Sharp.Flag" Color="Color.Secondary" />
                                            </ItemDot>
                                            <ItemContent>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption">@transportation.Traveltime.End?.ToShortDateString()</MudText>
                                                    <MudText Typo="Typo.caption" Class="fw-bold">@transportation.Traveltime.End?.ToShortTimeString()</MudText>
                                                </MudStack>
                                            </ItemContent>
                                            <ItemOpposite>
                                                <MudStack Spacing="0">
                                                    <MudText Typo="Typo.caption">@L["Transportation_Arrival"]</MudText>
                                                    <MudText Typo="Typo.caption"
                                                             Class="fw-bold"
                                                             title="@transportation.Arrival.Address?.ToString()">
                                                        @transportation.Arrival.Address?.Line1.ToString()
                                                    </MudText>
                                                </MudStack>
                                            </ItemOpposite>
                                        </MudTimelineItem>
                                    </MudTimeline>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

<MudStack Row>
    <MudButton Variant="Variant.Text"
               FullWidth
               StartIcon="@Icons.Material.Filled.Add"
               Class="text-travelsegment"
               Href="@LinkHelper.TransportationLinkCreate(Trip!.Id)">
        @L["TripOverview_AddTransportation"]
    </MudButton>
</MudStack>

@code {
    [Parameter] public GetTripResponse? Trip { get; set; }

    private DestinationDto? GetTargetDestination(TransportationDto transportation)
    {
        if (Trip?.TravelSegments == null || transportation.TargetReference == null)
            return null;

        if (transportation.TargetReference.IsDestination)
        {
            var destinationId = transportation.TargetReference.Id;
            return Trip.TravelSegments
                .SelectMany(seg => seg.Destinations)
                .FirstOrDefault(dest => dest.Id == destinationId);
        }
        return null;
    }
}