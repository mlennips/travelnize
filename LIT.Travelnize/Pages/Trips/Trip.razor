@page "/trips/{TripId:guid}"
@using Microsoft.AspNetCore.WebUtilities
@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Pages.Trips.Components
@using LIT.Travelnize.Shared.Map
@using LIT.Travelnize.Helpers
@inject TripsState TripsState
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject LIT.Travelnize.Services.ScrollService Scroll
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack Spacing="6">
        <PageHeader Title="@TripsState.SelectedTrip?.Name"
                    Subtitle="@L["Trip_TabSubtitle"]"
                    Image="Icons.Material.Filled.FlightTakeoff" />

        @if (TripsState.IsLoading)
        {
            <!-- Optional: Ladeanzeige -->
        }
        else if (TripsState.SelectedTrip != null)
        {
            <MudStack Spacing="4">
                <TripHeader Trip="@TripsState.SelectedTrip" TripId="@TripId" />

                <MudTabs ActivePanelIndex="@activeTabIndex" ActivePanelIndexChanged="OnTabChanged">
                    <MudTabPanel Text="@L["Trip_TabOverview"]">
                        <TripOverviewTab Trip="@TripsState.SelectedTrip" TripId="@TripId" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Trip_TabDayPlan"]">
                        <TripDayPlanTab Trip="@TripsState.SelectedTrip" TripId="@TripId" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Trip_TabParticipants"]">
                        <TripParticipantsTab Trip="@TripsState.SelectedTrip" />
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Trip_TabTransport"]">
                        <TripTransportTab Trip="@TripsState.SelectedTrip" />
                    </MudTabPanel>                  
                    <MudTabPanel Text="@L["Trip_TabCosts"]" Disabled>
                    </MudTabPanel>
                </MudTabs>
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Elevation="0" Variant="Variant.Filled" Dense="true">
                @L["Errors_TripNotFound"]
            </MudAlert>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public Guid TripId { get; set; }

    private int activeTabIndex = 0;

    [SupplyParameterFromQuery]
    private string? Area { get; set; }

    private static readonly string[] TabAreas = new[] { "overview", "dayplan", "participants", "transport", "costs" };

    protected override async Task OnInitializedAsync()
    {
        SetTabFromQuery();
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TripsState.SelectedTrip?.Id != TripId)
        {
            await TripsState.LoadTripAsync(TripId);
        }
        SetTabFromQuery();
    }

    private void SetTabFromQuery()
    {
        if (Area == null || Area == "overview")
        {
            activeTabIndex = 0;
        }
        else if (Area == "dayplan")
        {
            activeTabIndex = 1;
        }
        else if (Area == "participants")
        {
            activeTabIndex = 2;
        }
        else if (Area == "transport")
        {
            activeTabIndex = 3;
        }
        else if (Area == "costs")
        {
            activeTabIndex = 4;
        }
    }

    private void OnTabChanged(int newIndex)
    {
        activeTabIndex = newIndex;
        var area = TabAreas.ElementAtOrDefault(newIndex) ?? "overview";
        var uri = Navigation.GetUriWithQueryParameter("area", area);
        Navigation.NavigateTo(uri, forceLoad: false);
        Area = TabAreas.ElementAtOrDefault(newIndex) ?? "overview";
    }
}