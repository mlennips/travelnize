@page "/trips/{TripId:guid}"
@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.Queries
@inject TripsState TripsState

@*  ToDo Farben pro Stufe (Trip, Segment, Destination, Accommodation); Slot Component; *@

<PageTitle>Travelnize - @TripsState.SelectedTrip?.Name</PageTitle>

<MudContainer Fixed Class="my-6">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <MudPaper Class="d-flex flex-row mud-width-full py-4" Elevation="0">
                <MudAvatar Size="Size.Large" Class="bg-white mx-4">
                    <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="fw-bold">@TripsState.SelectedTrip?.Name</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-light">
                        Hier findest du alle Informationen zu deinem Trip.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            @if (TripsState.IsLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else if (TripsState.SelectedTrip != null)
            {
                <MudGrid Spacing="4">
                    <MudItem xs="12">
                        <MudPaper Class="bg-light text-bg-light pa-4" Elevation="0" Outlined="true">
                            <MudText>
                                @TripsState.SelectedTrip?.Description
                            </MudText>
                            <MudText>Zeitraum: @TripsState.SelectedTrip.Slot.ToShortDateString()</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Teilnehmer</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudAvatarGroup Spacing="2">
                            @foreach (var participant in TripsState.SelectedTrip.Participants.OrderBy(p => p.Name))
                            {
                                <MudAvatar title="@participant.Name">@participant.Initials</MudAvatar>
                            }
                        </MudAvatarGroup>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Reiseplan</MudText>
                    </MudItem>

                    @foreach (var travelSegment in TripsState.SelectedTrip.TravelSegments)
                    {
                        <MudItem xs="12">
                            <MudPaper Elevation="0"
                                      Class="bg-primary bg-opacity-75 text-bg-primary pa-4 d-flex align-items-center">
                                <MudIcon Icon="@Icons.Material.Filled.Landslide" Class="me-2" />
                                <MudText Typo="Typo.body2" Class="mb-0">
                                    @travelSegment.Slot.ToShortDateString() <b>@travelSegment.Description</b>
                                </MudText>
                            </MudPaper>
                        </MudItem>

                        @foreach (var destination in travelSegment.Destinations)
                        {
                            <MudItem xs="12" md="4">
                                <MudPaper Elevation="0"
                                          Style="min-height: 180px; position: relative; overflow: hidden;"
                                          Class="mud-width-full pa-4 bg-light text-bg-light">

                                    <div class="d-flex align-items-center">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationCity"
                                                 Color="Color.Tertiary"
                                                 Class="me-2" />
                                        <MudText Typo="Typo.body2">
                                            @destination.Slot.ToShortDateString()
                                        </MudText>
                                    </div>
                                    <MudText Typo="Typo.h6" Class="mb-0 fw-bolder" Color="Color.Tertiary">
                                        @destination.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mb-0">
                                        @destination.Description
                                    </MudText>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" md="8">
                                <MudPaper Elevation="0"
                                          Class="mud-width-full">
                                    <MudList T="AccommodationDto">
                                        @foreach (var accommodation in destination.Accommodations)
                                        {
                                            <MudListItem Icon="@Icons.Material.Filled.Hotel">
                                                <MudText Typo="Typo.caption" Class="mb-0">@accommodation.CheckIn?.ToShortDateString()</MudText>
                                                -
                                                <MudText Typo="Typo.caption" Class="mb-0">@accommodation.CheckOut?.ToShortDateString()</MudText>
                                                <MudText Typo="Typo.caption" Class="mb-0">@accommodation.Name</MudText>
                                            </MudListItem>
                                        }

                                        <MudListItem Icon="@Icons.Material.Filled.Attractions">
                                            <MudText Typo="Typo.caption" Class="mb-0">Demo Attraktion 1</MudText>
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.Attractions">
                                            <MudText Typo="Typo.caption" Class="mb-0">Demo Attraktion 2</MudText>
                                        </MudListItem>
                                    </MudList>
                                </MudPaper>
                            </MudItem>
                        }
                    }

                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Transport</MudText>

                        <MudList T="TransportationDto">
                            <MudListItem Icon="@Icons.Material.Filled.AirportShuttle">
                                <MudText Typo="Typo.caption" Class="mb-0">Demo Auto</MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.AirportShuttle">
                                <MudText Typo="Typo.caption" Class="mb-0">Demo Bus</MudText>
                            </MudListItem>
                        </MudList>
                    </MudItem>

                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Elevation="0" Variant="Variant.Filled" Dense="true">
                    Trip nicht gefunden.
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [Parameter] public Guid TripId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (TripsState.SelectedTrip?.Id != TripId)
        {
            await TripsState.LoadTripAsync(TripId);
        }
    }
}