@page "/trips/{TripId:guid}"
@using LIT.Travelnize.Store.Trips
@using MudBlazor
@inject IDispatcher Dispatcher
@inject IState<TripState> TripState
@inject IActionSubscriber ActionSubscriber

<PageTitle>Travelnize - Trip Details</PageTitle>

<MudContainer Fixed Class="my-6">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <MudPaper Class="d-flex flex-row mud-width-full py-4" Elevation="0">
                <MudAvatar Size="Size.Large" Class="bg-white mx-4">
                    <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Class="fw-bold">Trip Details</MudText>
                    <MudText Typo="Typo.subtitle2" Class="fw-light">
                        Hier findest du alle Informationen zu deinem Trip.
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            @if (TripState.Value.IsLoading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            }
            else if (TripState.Value.CurrentTrip != null)
            {
                <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.h6">@TripState.Value.CurrentTrip.Name</MudText>
@*                     <MudText Typo="Typo.body2">Start: @TripState.Value.CurrentTrip.StartDate?.ToShortDateString()</MudText>
                    <MudText Typo="Typo.body2">Ende: @TripState.Value.CurrentTrip.EndDate?.ToShortDateString()</MudText> *@
                    <MudText Typo="Typo.body2">Beschreibung: @TripState.Value.CurrentTrip.Description</MudText>
@*                     <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" OnClick="@EditTrip">
                        Bearbeiten
                    </MudButton> *@
                </MudPaper>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Elevation="0" Variant="Variant.Filled" Dense="true">
                    Trip nicht gefunden.
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [Parameter] public Guid TripId { get; set; }

    protected override void OnInitialized()
    {
        ActionSubscriber.SubscribeToAction<GetTripResultAction>(this, (action) => InvokeAsync(StateHasChanged));
    }

    protected override void OnParametersSet()
    {
        if (TripState.Value.CurrentTrip?.Id != TripId)
        {
            Dispatcher.Dispatch(new GetTripAction(new(TripId)));
        }
    }
}