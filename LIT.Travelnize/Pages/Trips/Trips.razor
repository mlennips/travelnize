@page "/trips"
@using LIT.Travelnize.Domain.Trips.Queries
@using LIT.Travelnize.Helpers
@inject IAuthService AuthService
@inject TripsState TripsState
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <PageHeader Title="@L["Trips_Title"]"
                        Subtitle="@L["Trips_Subtitle"]" 
                        Actions="HeaderActions" />
        </MudItem>

        <!-- Horizontale Timeline Darstellung aller Reisen -->
        @if (TimelineTrips.Any())
        {
            <MudItem xs="12">
                <MudPaper Elevation="0">
                    <MudTimeline TimelineOrientation="TimelineOrientation.Horizontal" TimelinePosition="TimelinePosition.Bottom">
                        @foreach (var trip in TimelineTrips)
                        {
                            <MudTimelineItem Size="Size.Small" Class="align-items-center" Color="@(trip.Status == TripStatus.Ongoing ? Color.Success : Color.Default)">
                                <ItemContent>
                                    <MudLink Typo="Typo.caption" Href="@LinkHelper.TripLink(trip.Id)" Underline="Underline.None">
                                        @trip.Name
                                    </MudLink>
                                    <MudHidden Breakpoint="Breakpoint.Xs" Invert="false">
                                        <MudText Typo="Typo.caption" Inline="false"><br />@trip.Slot?.Start?.ToShortDateString()</MudText>
                                    </MudHidden>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudPaper>
            </MudItem>
        }

        @foreach (var tripGroup in GroupedTrips.Where(x => x.Value.Any()))
        {
            string groupLabel = tripGroup.Key switch
            {
                var s when s == TripStatus.Ongoing => L["Trips_Status_Ongoing"],
                var s when s == TripStatus.Upcoming => L["Trips_Status_Upcoming"],
                var s when s == TripStatus.Pending => L["Trips_Status_Pending"],
                var s when s == TripStatus.Past => L["Trips_Status_Past"],
                _ => tripGroup.Key.Value
            };

            <MudItem xs="12">
                <MudPaper Elevation="0">
                    <MudText GutterBottom Typo="Typo.caption" Color="Color.Secondary">
                        @groupLabel
                    </MudText>
                </MudPaper>
                <MudStack Spacing="2">
                    @foreach (var trip in tripGroup.Value)
                    {
                        string statusDetail = trip.Status switch
                        {
                            var s when s == TripStatus.Upcoming =>
                                trip.Slot.DaysUntilStart == 0
                                    ? L["Trips_StatusDetail_UpcomingToday"]
                                    : L["Trips_StatusDetail_UpcomingInDays", trip.Slot.DaysUntilStart],
                            var s when s == TripStatus.Ongoing =>
                                L["Trips_StatusDetail_Ongoing", trip.Slot.ActiveDays, trip.Slot.TotalDaysInclusive, trip.Slot.RemainingDays],
                            var s when s == TripStatus.Past => L["Trips_StatusDetail_Past"],
                            var s when s == TripStatus.Pending => L["Trips_StatusDetail_Pending"],
                            _ => ""
                        };

                        <MudCard Class="my-2" Elevation="25">
                            <MudCardContent Class="pa-4">
                                <MudStack Breakpoint="Breakpoint.Xs" Row="true" StretchItems="StretchItems.Start">
                                    <MudStack Row="false" AlignItems="AlignItems.Stretch" StretchItems="StretchItems.Middle" Justify="Justify.FlexEnd"  Spacing="0">
                                        <MudLink Href="@LinkHelper.TripLink(trip.Id)" Underline="Underline.None" Class="text-trip fw-semibold" Typo="Typo.h6">
                                            @trip.Name
                                        </MudLink>
                                      
                                        @if (!string.IsNullOrWhiteSpace(trip.Description))
                                        {
                                            <MudText Typo="Typo.body2" Class="opacity-85">
                                                @trip.Description
                                            </MudText>
                                        }

                                        <MudPaper Elevation="0">
                                            <MudText Typo="Typo.caption" Class="mt-1">
                                                <PlanningSlotDisplay Slot="@trip.Slot" />
                                                <MudText Typo="Typo.caption" Class="opacity-75 ml-1">
                                                    @statusDetail
                                                </MudText>
                                            </MudText>

                                            @if (trip.Status == TripStatus.Ongoing && trip.Slot.TotalDaysInclusive > 0)
                                            {
                                                var progress = Math.Clamp(
                                                trip.Slot.TotalDaysInclusive == 0
                                                ? 0
                                                : (double)trip.Slot.ActiveDays / trip.Slot.TotalDaysInclusive * 100d,
                                                0, 100);

                                                <MudProgressLinear Class="mt-1" Color="Color.Primary" Value="@progress" Rounded="true" />
                                            }
                                        </MudPaper>
                                    </MudStack>
                                    <MudStack Row="false" Justify="Justify.FlexStart" StretchItems="StretchItems.End" Breakpoint="Breakpoint.Xs" Spacing="0">                                           
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">@trip.UserRole</MudChip>
                                        @if (trip.Slot.Nights > 0)
                                        {
                                            <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Size="Size.Small">
                                                @($"{trip.Slot.Nights} {L["Trips_NightsLabel"]}")
                                            </MudChip>
                                        }
                                        <MudButton Variant="Variant.Text"
                                                   Class="mt-1"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Href="@LinkHelper.TripLink(trip.Id)"
                                                   StartIcon="@Icons.Material.Filled.OpenInNew">
                                            @L["Common_Open"]
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    }

                </MudStack>

            </MudItem>
        }
        <MudItem xs="12">
            @if (!TripsState.IsLoading && TripsState.Trips?.Count() == 0)
            {
                <MudAlert Severity="Severity.Info" Elevation="0" Variant="Variant.Filled" Dense="true" Class="mt-4">
                    @L["Trips_NoTrips"]
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    // Timeline sortierte Reisen (Startdatum aufsteigend, null zuletzt)
    private IEnumerable<ListTripsResponse> TimelineTrips =>
        (TripsState.Trips ?? Enumerable.Empty<ListTripsResponse>())
            .Where(x => x.Status == TripStatus.Ongoing || x.Status == TripStatus.Upcoming)
            .OrderBy(t => t.Slot.Start ?? DateTime.MaxValue);

    Dictionary<TripStatus, ListTripsResponse[]> GroupedTrips
    {
        get
        {
            var dict = new Dictionary<TripStatus, ListTripsResponse[]>();
            if (TripsState.Trips != null)
            {
                dict.Add(TripStatus.Ongoing, TripsState.OngoingTrips.ToArray());
                dict.Add(TripStatus.Upcoming, TripsState.UpcomingTrips.ToArray());
                dict.Add(TripStatus.Pending, TripsState.PendingTrips.ToArray());
                dict.Add(TripStatus.Past, TripsState.PastTrips.ToArray());
            }
            return dict;
        }
    }

    IEnumerable<ButtonAction> HeaderActions => new[]
    {
        new ButtonAction 
        { 
            Text = L["Neue Reise"], 
            OnClick = () => NavigationManager.NavigateTo(LinkHelper.TripLinkCreate()),
            Icon = Icons.Material.Filled.Add
        },
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null)
        {
            await TripsState.LoadTripsAsync(user.UserId);
        }
    }
}
