@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/{DestinationId:guid}/activities/create"
@using System.ComponentModel.DataAnnotations
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditPageLayout Mode="PageLayoutMode.Create" TModel="ActivityCreateFormModel"
                Title="@L["Activity_CreateTitle"]"
                Subtitle="@L["Activity_CreateSubtitle"]"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@LinkHelper.TripLink(TripId)"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="@L["Activity_NameLabel"]"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="@L["Activity_NamePlaceholder"]" />
            </MudItem>
            <MudItem xs="12" sm="12">
                <MudTextField @bind-Value="FormModel!.Description"
                              Label="@L["Activity_DescriptionLabel"]"
                              For="@(()=>FormModel!.Description)"
                              Placeholder="@L["Activity_DescriptionPlaceholder"]"
                              Lines="3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.Date"
                               Label="@L["Activity_DateLabel"]"
                               For="@(()=>FormModel!.Date)"
                               Clearable="true"
                               MinDate="@MinDate"
                               MaxDate="@MaxDate" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" @bind-Value="FormModel!.DurationHours"
                                 Label="@L["Activity_DurationHoursLabel"]"
                                 Min="0" Max="24" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" @bind-Value="FormModel!.DurationMinutes"
                                 Label="@L["Activity_DurationMinutesLabel"]"
                                 Min="0" Max="59" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }
    [Parameter] public Guid DestinationId { get; set; }

    internal ActivityCreateFormModel? FormModel;
    internal bool IsLoading;
    internal string? LoadError;
    internal DateTime? MinDate;
    internal DateTime? MaxDate;

    private TravelSegmentDto? _segment;
    private DestinationDto? _destination;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeFormModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        IsLoading = true;
        LoadError = null;
        await TripsState.LoadTripAsync(TripId);
        if (TripsState.SelectedTrip == null)
        {
            LoadError = L["Errors_TripNotFound"];
        }
        IsLoading = false;
        StateHasChanged();
    }

    private void InitializeFormModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = L["Errors_TravelSegmentNotFound"];
            return;
        }

        _destination = _segment.Destinations.FirstOrDefault(d => d.Id == DestinationId);
        if (_destination == null)
        {
            LoadError = L["Errors_DestinationNotFound"];
            return;
        }

        FormModel ??= new ActivityCreateFormModel
        {
            TripId = TripId,
            DestinationId = DestinationId,
            Name = string.Empty,
            Description = string.Empty,
            Date = _destination.Slot.Start,
            DurationHours = 0,
            DurationMinutes = 0
        };

        MinDate = _destination.Slot.Start;
        MaxDate = _destination.Slot.End;
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        TimeSpan? duration = null;
        if (FormModel.DurationHours > 0 || FormModel.DurationMinutes > 0)
            duration = new TimeSpan(FormModel.DurationHours, FormModel.DurationMinutes, 0);

        var command = new AddActivityCommand(
            FormModel.TripId,
            FormModel.DestinationId,
            FormModel.Name!.Trim(),
            FormModel.Description ?? string.Empty,
            Location.Empty,
            FormModel.Date,
            duration
        );

        var newId = await TripsState.AddActivityAsync(FormModel.TripId, FormModel.DestinationId, command);
        if (newId.HasValue)
        {
            Navigation.NavigateTo(LinkHelper.ActivityLinkEdit(TripId, TravelSegmentId, DestinationId, newId.Value));
        }
        else
        {
            LoadError = TripsState.LastError ?? L["Errors_CreateFailed"];
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeFormModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class ActivityCreateFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid DestinationId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [StringLength(500, ErrorMessage = "Maximal 500 Zeichen.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Datum ist erforderlich.")]
        public DateTime? Date { get; set; }

        public int DurationHours { get; set; }
        public int DurationMinutes { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult("Name ist erforderlich.", new[] { nameof(Name) });
            }
        }
    }
}