@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/{DestinationId:guid}/accommodations/create"
@using LIT.Travelnize.Domain.Trips.Commands
@using LIT.Travelnize.Domain.Trips.Dtos
@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Domain.Common
@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Layout
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Travelnize - Unterkunft hinzufügen</PageTitle>

<EditPageLayout TModel="AccommodationCreateFormModel"
                Title="Unterkunft hinzufügen"
                Subtitle="Lege eine neue Unterkunft für dein Reiseziel an."
                ContainerClass="my-6"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@($"/trips/{TripId}")"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">

            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="Name"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="Name der Unterkunft" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="FormModel!.Type"
                           Label="Typ"
                           For="@(()=>FormModel!.Type)"
                           Required="true">
                    @foreach (var t in AccommodationType.DefaultValues)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.CheckIn"
                               Label="Check-In"
                               For="@(()=>FormModel!.CheckIn)"
                               MaxDate="FormModel!.CheckOut"
                               Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FormModel!.CheckOut"
                               Label="Check-Out"
                               For="@(()=>FormModel!.CheckOut)"
                               MinDate="FormModel!.CheckIn"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Adresse</MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FormModel!.AddressLine1"
                              Label="Adresszeile 1"
                              For="@(()=>FormModel!.AddressLine1)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="FormModel!.AddressLine2"
                              Label="Adresszeile 2"
                              For="@(()=>FormModel!.AddressLine2)" />
            </MudItem>

            <MudItem xs="12" sm="5">
                <MudTextField @bind-Value="FormModel!.Street"
                              Label="Straße"
                              For="@(()=>FormModel!.Street)" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudTextField @bind-Value="FormModel!.HouseNumber"
                              Label="Nr."
                              For="@(()=>FormModel!.HouseNumber)" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudTextField @bind-Value="FormModel!.PostalCode"
                              Label="PLZ"
                              For="@(()=>FormModel!.PostalCode)" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="FormModel!.City"
                              Label="Stadt"
                              For="@(()=>FormModel!.City)" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="FormModel!.Country"
                              Label="Land"
                              For="@(()=>FormModel!.Country)" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }
    [Parameter] public Guid DestinationId { get; set; }

    internal AccommodationCreateFormModel? FormModel;
    internal bool IsLoading;
    internal string? LoadError;

    private TravelSegmentDto? _segment;
    private DestinationDto? _destination;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeFormModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = "Reise wurde nicht gefunden.";
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeFormModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = "Reiseabschnitt wurde nicht gefunden.";
            return;
        }

        _destination = _segment.Destinations.FirstOrDefault(d => d.Id == DestinationId);
        if (_destination == null)
        {
            LoadError = "Ziel wurde nicht gefunden.";
            return;
        }

        // Voreinstellungen: Slot des Ziels übernehmen (optional)
        var start = _destination.Accommodations.Any() ? 
            _destination.Accommodations.OrderByDescending(x => x.CheckInOut.End).First().CheckInOut.End
            : _destination.Slot.Start;
        var end = _destination.Slot.End;

        FormModel ??= new AccommodationCreateFormModel
        {
            TripId = TripId,
            DestinationId = DestinationId,
            Name = string.Empty,
            Type = AccommodationType.Default.Value,
            CheckIn = start,
            CheckOut = end
        };
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var address = new Address(
                FormModel.AddressLine1 ?? string.Empty,
                FormModel.AddressLine2 ?? string.Empty,
                FormModel.Street ?? string.Empty,
                FormModel.HouseNumber ?? string.Empty,
                FormModel.PostalCode ?? string.Empty,
                FormModel.City ?? string.Empty,
                FormModel.Country ?? string.Empty
            );

            var slot = PlanningSlot.Create(FormModel.CheckIn, FormModel.CheckOut);

            var command = new AddAccommodationCommand(
                FormModel.TripId,
                FormModel.DestinationId,
                FormModel.Name!.Trim(),
                new AccommodationType(FormModel.Type!),
                address,
                slot
            );

            var newId = await TripsState.AddAccommodationAsync(FormModel.TripId, FormModel.DestinationId, command);
            if (newId.HasValue)
            {
                Snackbar.Add("Unterkunft erstellt.", Severity.Success);
                Navigation.NavigateTo($"/trips/{TripId}");
            }
            else
            {
                Snackbar.Add("Erstellung fehlgeschlagen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fehler: " + ex.Message, Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeFormModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class AccommodationCreateFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid DestinationId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Typ ist erforderlich.")]
        [StringLength(80, ErrorMessage = "Maximal 80 Zeichen.")]
        public string? Type { get; set; }

        [Required(ErrorMessage = "Check-In ist erforderlich.")]
        public DateTime? CheckIn { get; set; }

        [Required(ErrorMessage = "Check-Out ist erforderlich.")]
        public DateTime? CheckOut { get; set; }

        [StringLength(200)] public string? AddressLine1 { get; set; }
        [StringLength(200)] public string? AddressLine2 { get; set; }
        [StringLength(150)] public string? Street { get; set; }
        [StringLength(30)]  public string? HouseNumber { get; set; }
        [StringLength(20)]  public string? PostalCode { get; set; }
        [StringLength(100)] public string? City { get; set; }
        [StringLength(100)] public string? Country { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (CheckIn.HasValue && CheckOut.HasValue && CheckIn.Value >= CheckOut.Value)
            {
                yield return new ValidationResult("Check-In muss vor Check-Out liegen.", new[] { nameof(CheckOut) });
            }
        }
    }
}