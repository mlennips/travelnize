@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/{DestinationId:guid}/accommodations/create"
@using System.ComponentModel.DataAnnotations
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Travelnize - Unterkunft hinzufügen</PageTitle>

<EditPageLayout Mode="PageLayoutMode.Create" TModel="AccommodationCreateFormModel"
                Title="Unterkunft hinzufügen"
                Subtitle="Lege eine neue Unterkunft für dein Reiseziel an."
                ContainerClass="my-6"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@($"/trips/{TripId}")"
                OnValidSubmit="HandleValidSubmit">
    <FormContent>
        <MudGrid Spacing="4">

            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="Name"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="Name der Unterkunft" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="FormModel!.Type"
                           Label="Typ"
                           For="@(()=>FormModel!.Type)"
                           Required="true">
                    @foreach (var t in AccommodationType.DefaultValues)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <PlanningSlotEdit Model="FormModel!.CheckInOutModel" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2">Adresse</MudText>
            </MudItem>
            <MudItem xs="12">
                <AddressEdit Model="AddressModel" />
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }
    [Parameter] public Guid DestinationId { get; set; }

    internal AccommodationCreateFormModel? FormModel;
    internal AddressEdit.AddressEditModel AddressModel { get; set; } = new();
    internal bool IsLoading;
    internal string? LoadError;

    private TravelSegmentDto? _segment;
    private DestinationDto? _destination;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeFormModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        try
        {
            IsLoading = true;
            LoadError = null;
            await TripsState.LoadTripAsync(TripId);
            if (TripsState.SelectedTrip == null)
            {
                LoadError = "Reise wurde nicht gefunden.";
            }
        }
        catch (Exception ex)
        {
            LoadError = "Fehler beim Laden: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void InitializeFormModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = "Reiseabschnitt wurde nicht gefunden.";
            return;
        }

        _destination = _segment.Destinations.FirstOrDefault(d => d.Id == DestinationId);
        if (_destination == null)
        {
            LoadError = "Ziel wurde nicht gefunden.";
            return;
        }

        var start = _destination.Accommodations.Any() ? 
            _destination.Accommodations.OrderByDescending(x => x.CheckInOut.End).First().CheckInOut.End
            : _destination.Slot.Start;
        var end = _destination.Slot.End;

        FormModel ??= new AccommodationCreateFormModel
        {
            TripId = TripId,
            DestinationId = DestinationId,
            Name = string.Empty,
            Type = AccommodationType.Default.Value,
            CheckInOutModel = new PlanningSlotEdit.PlanningSlotEditModel(new PlanningSlot(start, end)),
            Address = new AddressEdit.AddressEditModel()
        };
        AddressModel = FormModel.Address;
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        try
        {
            var slot = FormModel.CheckInOutModel.ToPlanningSlot();

            var command = new AddAccommodationCommand(
                FormModel.TripId,
                FormModel.DestinationId,
                FormModel.Name!.Trim(),
                new AccommodationType(FormModel.Type!),
                FormModel.Address.ToAddress(),
                slot
            );

            var newId = await TripsState.AddAccommodationAsync(FormModel.TripId, FormModel.DestinationId, command);
            if (newId.HasValue)
            {
                Snackbar.Add("Unterkunft erstellt.", Severity.Success);
                Navigation.NavigateTo($"/trips/{TripId}/travelsegments/{TravelSegmentId}/destinations/{DestinationId}/accommodations/{newId}/edit");
            }
            else
            {
                Snackbar.Add("Erstellung fehlgeschlagen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Fehler: " + ex.Message, Severity.Error);
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeFormModel();
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class AccommodationCreateFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid DestinationId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Typ ist erforderlich.")]
        [StringLength(80, ErrorMessage = "Maximal 80 Zeichen.")]
        public string? Type { get; set; }

        public PlanningSlotEdit.PlanningSlotEditModel CheckInOutModel { get; set; } = new();

        public AddressEdit.AddressEditModel Address { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (CheckInOutModel.Start.HasValue && CheckInOutModel.End.HasValue && CheckInOutModel.Start.Value >= CheckInOutModel.End.Value)
            {
                yield return new ValidationResult("Check-In muss vor Check-Out liegen.", new[] { nameof(CheckInOutModel.End) });
            }
        }
    }
}