@page "/trips/{TripId:guid}/travelsegments/{TravelSegmentId:guid}/destinations/{DestinationId:guid}/accommodations/{AccommodationId:guid}/edit"
@using System.ComponentModel.DataAnnotations
@inject TripsState TripsState
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditPageLayout TModel="AccommodationEditFormModel"
                Title="@L["Accommodation_EditTitle"]"
                Subtitle="@L["Accommodation_EditSubtitle"]"
                Model="FormModel"
                IsLoading="IsLoading"
                LoadError="LoadError"
                CancelHref="@LinkHelper.TripLink(TripId)"
                OnValidSubmit="HandleValidSubmit"
                OnDeleteConfirmed="DeleteAccommodationAsync">
    <FormContent>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="FormModel!.Name"
                              Label="@L["Accommodation_NameLabel"]"
                              For="@(()=>FormModel!.Name)"
                              Required="true"
                              Placeholder="@L["Accommodation_NamePlaceholder"]" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudSelect T="string" @bind-Value="FormModel!.Type"
                           Label="@L["Accommodation_TypeLabel"]"
                           For="@(()=>FormModel!.Type)"
                           Required="true">
                    @foreach (var t in AccommodationType.DefaultValues)
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <PlanningSlotEdit Model="FormModel!.CheckInOutModel" Label="@L["Accommodation_CheckInOut"]" GutterTop />
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="pa-4">
                    <AddressEdit Model="FormModel!.AddressModel" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12">                
                <MudPaper Class="pa-4">
                    <BookingInfoEdit Model="FormModel!.BookingInfoModel" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </FormContent>
</EditPageLayout>

@code {
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public Guid TravelSegmentId { get; set; }
    [Parameter] public Guid DestinationId { get; set; }
    [Parameter] public Guid AccommodationId { get; set; }

    internal AccommodationEditFormModel? FormModel;
    internal bool IsLoading;
    internal string? LoadError;

    private TravelSegmentDto? _segment;
    private DestinationDto? _destination;
    private AccommodationDto? _accommodation;

    protected override void OnInitialized()
    {
        TripsState.OnChange += StateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureTripLoadedAsync();
        InitializeAccommodationModel();
    }

    private async Task EnsureTripLoadedAsync()
    {
        if (TripsState.SelectedTrip == null || TripsState.SelectedTrip.Id != TripId)
        {
            await LoadTripAsync();
        }
    }

    private async Task LoadTripAsync()
    {
        IsLoading = true;
        LoadError = null;
        await TripsState.LoadTripAsync(TripId);
        if (TripsState.SelectedTrip == null)
        {
            LoadError = L["Errors_TripNotFound"];
        }
        IsLoading = false;
        StateHasChanged();
    }

    private void InitializeAccommodationModel()
    {
        if (TripsState.SelectedTrip == null) return;

        _segment = TripsState.SelectedTrip.TravelSegments.FirstOrDefault(s => s.Id == TravelSegmentId);
        if (_segment == null)
        {
            LoadError = L["Errors_TravelSegmentNotFound"];
            return;
        }

        _destination = _segment.Destinations.FirstOrDefault(d => d.Id == DestinationId);
        if (_destination == null)
        {
            LoadError = L["Errors_DestinationNotFound"];
            return;
        }

        _accommodation = _destination.Accommodations.FirstOrDefault(a => a.Id == AccommodationId);
        if (_accommodation == null)
        {
            LoadError = L["Errors_AccommodationNotFound"];
            return;
        }

        FormModel = new AccommodationEditFormModel
        {
            TripId = TripId,
            DestinationId = DestinationId,
            AccommodationId = AccommodationId,
            Name = _accommodation.Name,
            Type = _accommodation.Type.Value,
            AddressModel = new AddressEdit.AddressEditModel(_accommodation.Address),
            CheckInOutModel = new PlanningSlotEdit.PlanningSlotEditModel(_accommodation.CheckInOut),
            BookingInfoModel = new BookingInfoEdit.BookingInfoEditModel(_accommodation.BookingInfo)
        };
    }

    private async Task HandleValidSubmit(EditContext _)
    {
        if (FormModel == null) return;

        var command = new UpdateAccommodationCommand(
            FormModel.TripId,
            FormModel.DestinationId,
            FormModel.AccommodationId,
            FormModel.Name!.Trim(),
            new AccommodationType(FormModel.Type!),
            FormModel.AddressModel.ToAddress(),
            FormModel.CheckInOutModel.ToPlanningSlot(),
            FormModel.BookingInfoModel.ToBookingInfo()
        );

        var result = await TripsState.UpdateAccommodationAsync(FormModel.TripId, command);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(LinkHelper.TripLink(TripId));
        }
        else
        {
            LoadError = TripsState.LastError ?? L["Errors_UpdateFailed"];
        }
    }

    private void StateChanged()
    {
        InvokeAsync(() =>
        {
            if (TripsState.SelectedTrip != null &&
                TripsState.SelectedTrip.Id == TripId)
            {
                InitializeAccommodationModel();
            }
            StateHasChanged();
        });
    }

    private async Task DeleteAccommodationAsync()
    {
        var result = await TripsState.RemoveAccommodationAsync(TripId, DestinationId, AccommodationId);
        if (result.IsSuccess)
        {
            Navigation.NavigateTo(LinkHelper.TripLink(TripId));
        }
        else
        {
            LoadError = TripsState.LastError ?? L["Errors_DeleteFailed"];
        }
    }

    public void Dispose()
    {
        TripsState.OnChange -= StateChanged;
    }

    internal class AccommodationEditFormModel : IValidatableObject
    {
        public Guid TripId { get; set; }
        public Guid DestinationId { get; set; }
        public Guid AccommodationId { get; set; }

        [Required(ErrorMessage = "Name ist erforderlich.")]
        [StringLength(150, ErrorMessage = "Maximal 150 Zeichen.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Typ ist erforderlich.")]
        [StringLength(80, ErrorMessage = "Maximal 80 Zeichen.")]
        public string? Type { get; set; }

        internal PlanningSlotEdit.PlanningSlotEditModel CheckInOutModel { get; set; } = new();
        internal AddressEdit.AddressEditModel AddressModel { get; set; } = new();
        internal BookingInfoEdit.BookingInfoEditModel BookingInfoModel { get; set; } = new();

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            return Array.Empty<ValidationResult>();
        }
    }
}