{
  email admin@lennips.de
  # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory  # nur falls wieder Staging
}

# HTTPS
travelnize.lennips.de {
  encode zstd gzip

  @api path /api/*
  reverse_proxy @api api:8080

  root * /srv
  try_files {path} /index.html
  file_server

  header {
    @fw path /_framework/*
    Cache-Control @fw "public, max-age=31536000, immutable"

    @assets {
      path_regexp assets \.(dll|pdb|wasm|js|mjs|css|json|png|jpg|jpeg|gif|svg|ico|woff2?)$
    }
    Cache-Control @assets "public, max-age=3600"
  }

  log {
    output stdout
    level INFO
  }
}

# HTTP (Port 8081)
:8081 {
  encode gzip

  handle /api/* {
    reverse_proxy api:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
    header {
      Cache-Control "no-cache, no-store, must-revalidate"
      Pragma "no-cache"
      Expires "0"
    }
  }

  log {
    output stdout
    level INFO
  }
}