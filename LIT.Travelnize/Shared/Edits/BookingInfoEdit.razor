@using LIT.Travelnize.Domain.Trips.ValueObjects
@using LIT.Travelnize.Domain.Common
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (GutterTop)
{
    <GutterTop />
}

<EditForm Model="Model">
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudText Typo="Typo.subtitle2">@Label</MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.Provider"
                          Label="@L["BookingInfo_ProviderLabel"]"
                          For="@(() => Model.Provider)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.BookingNumber"
                          Label="@L["BookingInfo_BookingNumberLabel"]"
                          For="@(() => Model.BookingNumber)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker @bind-Date="Model.BookingDate"
                           Label="@L["BookingInfo_BookingDateLabel"]"
                           For="@(() => Model.BookingDate)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <ResourceReferenceEdit Model="Model.UrlModel" ForceKind="ResourceKind.Website" HideLabel />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="Model.Details"
                          Label="@L["BookingInfo_DetailsLabel"]"
                          For="@(() => Model.Details)"
                          Lines="3" />
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public BookingInfoEditModel Model { get; set; } = new();

    [Parameter]
    public string? Label { get; set; }

    [Parameter] public bool GutterTop { get; set; } = false;

    protected override void OnInitialized()
    {
        Label ??= L["BookingInfo_Singular"];
    }

    public class BookingInfoEditModel
    {
        public string Provider { get; set; } = string.Empty;
        public string BookingNumber { get; set; } = string.Empty;
        public DateTime? BookingDate { get; set; }
        public ResourceReferenceEdit.ResourceReferenceEditModel UrlModel { get; set; } = new();
        public string Details { get; set; } = string.Empty;

        public BookingInfoEditModel() { }

        public BookingInfoEditModel(BookingInfo? info)
        {
            if (info is not null)
            {
                Provider = info.Provider;
                BookingNumber = info.BookingNumber;
                BookingDate = info.BookingDate;
                UrlModel = new ResourceReferenceEdit.ResourceReferenceEditModel(info.Url);
                Details = info.Details;
            }
        }

        public BookingInfo ToBookingInfo()
        {
            var utcDate = BookingDate.HasValue
                ? DateTime.SpecifyKind(BookingDate.Value.ToUniversalTime(), DateTimeKind.Utc)
                : (DateTime?)null;

            return new BookingInfo(
                Provider,
                BookingNumber,
                utcDate,
                UrlModel.ToResourceReference(),
                Details
            );
        }
    }
}