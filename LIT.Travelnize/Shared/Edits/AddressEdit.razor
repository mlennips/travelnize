@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Common
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditForm Model="Model">
    <MudGrid Spacing="4">
        <MudItem xs="12">
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2">@Title</MudText>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.Line1"
                          Label="@L["Address_Line1Label"]"
                          For="@(() => Model.Line1)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="Model.Line2"
                          Label="@L["Address_Line2Label"]"
                          For="@(() => Model.Line2)" />
        </MudItem>
        <MudItem xs="12" sm="5">
            <MudTextField @bind-Value="Model.Street"
                          Label="@L["Address_StreetLabel"]"
                          For="@(() => Model.Street)" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudTextField @bind-Value="Model.HouseNumber"
                          Label="@L["Address_HouseNumberLabel"]"
                          For="@(() => Model.HouseNumber)" />
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudTextField @bind-Value="Model.PostalCode"
                          Label="@L["Address_PostalCodeLabel"]"
                          For="@(() => Model.PostalCode)" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="Model.City"
                          Label="@L["Address_CityLabel"]"
                          For="@(() => Model.City)" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="Model.Country"
                          Label="@L["Address_CountryLabel"]"
                          For="@(() => Model.Country)" />
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public AddressEditModel Model { get; set; } = new();

    public string Title => L["Address_Singular"];

    public class AddressEditModel(Address? address = null)
    {
        [StringLength(200)] public string Line1 { get; set; } = address?.Line1 ?? "";
        [StringLength(200)] public string Line2 { get; set; } = address?.Line2 ?? "";
        [StringLength(150)] public string Street { get; set; } = address?.Street ?? "";
        [StringLength(30)] public string HouseNumber { get; set; } = address?.HouseNumber ?? "";
        [StringLength(20)] public string PostalCode { get; set; } = address?.PostalCode ?? "";
        [StringLength(100)] public string City { get; set; } = address?.City ?? "";
        [StringLength(100)] public string Country { get; set; } = address?.Country ?? "";

        public Address ToAddress() => new()
        {
            Line1 = Line1,
            Line2 = Line2,
            Street = Street,
            HouseNumber = HouseNumber,
            PostalCode = PostalCode,
            City = City,
            Country = Country
        };
    }
}