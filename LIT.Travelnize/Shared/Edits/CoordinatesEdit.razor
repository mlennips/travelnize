@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Common
@using MudBlazor
@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<MudGrid Spacing="4">
    <MudItem xs="12">
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">@L["Coordinate_Plural"]</MudText>
    </MudItem>
    <MudItem xs="12" sm="4" lg="5">
        <MudNumericField T="double?" @bind-Value="Model.Latitude"
                         Label="@L["Coordinates_LatitudeLabel"]"
                         For="@(() => Model.Latitude)"
                         Immediate="true"
                         Clearable="true"
                         Placeholder="@L["Coordinates_LatitudePlaceholder"]"
                         Min="-90" Max="90" />
    </MudItem>
    <MudItem xs="12" sm="4" lg="5">
        <MudNumericField T="double?" @bind-Value="Model.Longitude"
                         Label="@L["Coordinates_LongitudeLabel"]"
                         For="@(() => Model.Longitude)"
                         Immediate="true"
                         Clearable="true"
                         Placeholder="@L["Coordinates_LongitudePlaceholder"]"
                         Min="-180" Max="180" />
    </MudItem>
    <MudItem xs="12" sm="4" lg="2" Class="d-flex align-items-end">
        <MudButton Variant="Variant.Filled"
                   FullWidth
                   Color="Color.Tertiary"
                   StartIcon="@(_showMap ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Map)"
                   OnClick="@ToggleMap">
            @(_showMap ? L["Coordinates_HideMap"] : L["Coordinates_ShowMap"])
        </MudButton>
    </MudItem>
    @if (_showMap)
    {
        <MudItem xs="12">
            <div id="coord-edit-map" style="height: 350px;"></div>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter, EditorRequired]
    public CoordinatesEditModel Model { get; set; }

    private bool _mapInitialized;
    private double? _lastLat;
    private double? _lastLon;
    private DotNetObjectReference<CoordinatesEdit>? _dotNetRef;
    private bool _showMap = false;

    private void ToggleMap()
    {
        _showMap = !_showMap;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showMap && !_mapInitialized)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "travelnizeLeaflet.dispose", "coord-edit-map"
            );
            await JS.InvokeVoidAsync(
                "travelnizeLeaflet.init",
                "coord-edit-map",
                Model.Latitude ?? 52.52,
                Model.Longitude ?? 13.405,
                (Model.Latitude == 0 && Model.Longitude == 0 ? 1 : 13),
                null,
                null,
                "#1976d2",
                new { disableInteraction = false },
                _dotNetRef
            );
            _mapInitialized = true;
            _lastLat = Model.Latitude;
            _lastLon = Model.Longitude;
            StateHasChanged();
        }
        else if (!_showMap && _mapInitialized)
        {
            await JS.InvokeVoidAsync("travelnizeLeaflet.dispose", "coord-edit-map");
            _mapInitialized = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_showMap && _mapInitialized &&
            Model.Latitude.HasValue && Model.Longitude.HasValue &&
            (Model.Latitude != _lastLat || Model.Longitude != _lastLon))
        {
            await JS.InvokeVoidAsync(
                "travelnizeLeaflet.update",
                "coord-edit-map",
                Model.Latitude.Value,
                Model.Longitude.Value,
                (Model.Latitude == 0 && Model.Longitude == 0 ? 1 : 13),
                "#1976d2"
            );
            _lastLat = Model.Latitude;
            _lastLon = Model.Longitude;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnMapCoordinateChanged(double lat, double lon)
    {
        Model.Latitude = lat;
        Model.Longitude = lon;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapInitialized)
        {
            await JS.InvokeVoidAsync("travelnizeLeaflet.dispose", "coord-edit-map");
            _mapInitialized = false;
        }
        _dotNetRef?.Dispose();
    }

    public class CoordinatesEditModel(Coordinates? coordinates)
    {
        [Range(-90, 90, ErrorMessage = "Latitude muss zwischen -90 und 90 liegen.")]
        public double? Latitude { get; set; } = coordinates?.Latitude;

        [Range(-180, 180, ErrorMessage = "Longitude muss zwischen -180 und 180 liegen.")]
        public double? Longitude { get; set; } = coordinates?.Longitude;

        public Coordinates ToCoordinates()
        {
            return new Coordinates
                {
                    Latitude = Latitude ?? 0,
                    Longitude = Longitude ?? 0
                };
        }
    }
}