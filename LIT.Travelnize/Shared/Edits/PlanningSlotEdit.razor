    @using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Trips.ValueObjects
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditForm Model="Model">
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6">
            <MudDatePicker @bind-Date="Model.Start"
                           Label="@L["PlanningSlot_StartDateLabel"]"
                           For="@(() => Model.Start)"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker @bind-Date="Model.End"
                           Label="@L["PlanningSlot_EndDateLabel"]"
                           For="@(() => Model.End)"
                           MinDate="Model.Start"
                           HelperText="@L["PlanningSlot_HelperText", Model.TotalDaysInclusive, Model.Nights]"
                           Clearable="true" />
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PlanningSlotEditModel Model { get; set; } = new();

    public class PlanningSlotEditModel
    {
        [Required(ErrorMessage = "Startdatum ist erforderlich.")]
        public DateTime? Start { get; set; }

        [Required(ErrorMessage = "Enddatum ist erforderlich.")]
        public DateTime? End { get; set; }

        public int TotalDays =>
            Start.HasValue && End.HasValue
                ? (End.Value.Date - Start.Value.Date).Days
                : 0;

        public int TotalDaysInclusive =>
            Start.HasValue && End.HasValue
                ? (End.Value.Date - Start.Value.Date).Days + 1
                : 0;

        public int Nights =>
            Start.HasValue && End.HasValue
                ? Math.Max(0, (End.Value.Date - Start.Value.Date).Days)
                : 0;

        public PlanningSlotEditModel() { }

        public PlanningSlotEditModel(PlanningSlot? slot)
        {
            Start = slot?.Start;
            End = slot?.End;
        }

        public PlanningSlot ToPlanningSlot() => PlanningSlot.Create(Start, End);
    }
}