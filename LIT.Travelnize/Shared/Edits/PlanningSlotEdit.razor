@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Trips.ValueObjects
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (GutterTop)
{
    <GutterTop />
}

<EditForm Model="@Model">
    <MudGrid Spacing="4">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">@Label</MudText>
            </MudItem>
        }
        <MudItem xs="12" sm="6">
            <MudTextField T="DateTime?"
                          @bind-Value="Model.Start"
                          Label="@L["PlanningSlot_StartDateLabel"]"
                          For="@(() => Model.Start)"
                          InputType="@(ShowTime ? InputType.DateTimeLocal : InputType.Date)"
                          Format="@(ShowTime ? "s" : "yyyy-MM-dd")"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="DateTime?"
                          @bind-Value="Model.End"
                          Label="@L["PlanningSlot_EndDateLabel"]"
                          For="@(() => Model.End)"
                          InputType="@(ShowTime ? InputType.DateTimeLocal : InputType.Date)"
                          Format="@(ShowTime ? "s" : "yyyy-MM-dd")"
                          Min="@Model.Start"
                          HelperText="@L["PlanningSlot_HelperText", Model.TotalDaysInclusive, Model.Nights]"
                          Clearable="true" />
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public PlanningSlotEditModel Model { get; set; } = new();

    [Parameter] public bool ShowTime { get; set; } = false;
    [Parameter] public string Label { get; set; } = default!;
    [Parameter] public bool GutterTop { get; set; } = false;

    public class PlanningSlotEditModel
    {
        public DateTime? Start { get; set; } 

        public DateTime? End { get; set; }

        public int TotalDays =>
            Start.HasValue && End.HasValue
                ? (End.Value.Date - Start.Value.Date).Days
                : 0;

        public int TotalDaysInclusive =>
            Start.HasValue && End.HasValue
                ? (End.Value.Date - Start.Value.Date).Days + 1
                : 0;

        public int Nights =>
            Start.HasValue && End.HasValue
                ? Math.Max(0, (End.Value.Date - Start.Value.Date).Days)
                : 0;

        public PlanningSlotEditModel() { }

        public PlanningSlotEditModel(PlanningSlot? slot)
        {
            Start = slot?.Start.HasValue == true ? DateTime.SpecifyKind(slot.Start.Value, DateTimeKind.Utc) : (DateTime?)null;
            End = slot?.End.HasValue == true ? DateTime.SpecifyKind(slot.End.Value, DateTimeKind.Utc) : (DateTime?)null;            
        }

        public PlanningSlot ToPlanningSlot() => PlanningSlot.Create(Start, End);
    }
}