@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Common
@using LIT.Travelnize.Shared.Dialogs
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (GutterTop)
{
    <GutterTop />
}

<EditForm Model="Model">
    <MudGrid Spacing="4">
        @if (!HideLabel)
        {
            var labelText = string.IsNullOrWhiteSpace(Label)
                ? @GetKindDisplayText(Model.Kind)
                : Label;
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">@labelText</MudText>
            </MudItem>
        }
        @if (ForceKind == ResourceKind.Website)
        {
            <MudItem xs="12">
                <MudTextField @bind-Value="Model.Source"
                              Label="@SourceLabel"
                              For="@(() => Model.Source)"
                              HelperText="@L["ResourceReference_UrlLabel"]"
                              Clearable />
            </MudItem>
        }
        else
        {
            <MudItem xs="6" sm="3" lg="4">
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="Model.Source"
                                  Label="@L["ResourceReference_SourceLabel"]"
                                  For="@(() => Model.Source)"
                                  HelperText="@($"{GetKindDisplayText(Model.Kind)} {L["ResourceReference_UrlLabel"]}")"
                                  Clearable />
                    @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                    {
                        <MudImage Src="@Model.Source"
                                  Height="26"
                                  Alt="@L["ResourceReference_SourceLabel"]" />
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="6" sm="3" lg="4">
                <MudStack Row AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="Model.Thumbnail"
                                  Label="@L["ResourceReference_ThumbnailLabel"]"
                                  HelperText="@L["ResourceReference_OptionalLabel"]"
                                  For="@(() => Model.Thumbnail)"
                                  Clearable />
                    @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                    {
                        <MudImage Src="@Model.Thumbnail"
                                  Height="26"
                                  Alt="@L["ResourceReference_ThumbnailLabel"]" />
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="9" sm="3" lg="2">
                <MudTextField @bind-Value="Model.Name"
                              Label="@L["ResourceReference_NameLabel"]"
                              HelperText="@L["ResourceReference_OptionalLabel"]"                          
                              For="@(() => Model.Name)" 
                              Clearable />
            </MudItem>
            <MudItem xs="3" sm="3" lg="2" Class="d-flex align-items-center justify-content-end">
                <MudButtonGroup Color="Color.Tertiary">
                    <MudIconButton Variant="Variant.Filled"
                                    Disabled="ForceKind != null"
                                    OnClick="OpenKindDialog" 
                                    Icon="@Icons.Material.Filled.Category"
                                    title="@GetKindDisplayText(Model.Kind)">                    
                    </MudIconButton>
                </MudButtonGroup>
            </MudItem>
        }
    </MudGrid>
</EditForm>

@code {
    [Inject] IDialogService DialogService { get; set; } = default!;

    [Parameter, EditorRequired] public ResourceReferenceEditModel Model { get; set; } = new();
    [Parameter] public ResourceKind? ForceKind { get; set; }
    [Parameter] public bool HideLabel { get; set; } = false;
    [Parameter] public string Label { get; set; } = default!;
    [Parameter] public string SourceLabel { get; set; } = default!;
    [Parameter] public bool GutterTop { get; set; } = false;

    protected override void OnInitialized()
    {
        SourceLabel ??= L["ResourceReference_SourceLabel"];
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ForceKind != null && Model != null)
        {
            Model.Kind = ForceKind.Value;
        }
    }

    private bool ShowSource =>
        ForceKind is null || ForceKind == ResourceKind.Website || ForceKind == ResourceKind.Image ||
        ForceKind == ResourceKind.Document || ForceKind == ResourceKind.Audio || ForceKind == ResourceKind.Video;

    private bool ShowThumbnail =>
        ForceKind is null || ForceKind == ResourceKind.Image;

    private bool ShowName =>
        ForceKind is null || ForceKind == ResourceKind.Image || ForceKind == ResourceKind.Document ||
        ForceKind == ResourceKind.Audio || ForceKind == ResourceKind.Video;

    private async Task OpenKindDialog()
    {
        if (ForceKind != null)
            return;

        IDialogReference? dialog = null;
        var items = Enum.GetValues<ResourceKind>()
            .Select(kind => new SingleSelectionDialog.SingleSelectionItem(
                GetKindDisplayText(kind),
                () => { Model.Kind = kind; StateHasChanged(); dialog?.Close(); }
            )).ToList();

        var parameters = new DialogParameters { ["Items"] = items };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        dialog = await DialogService.ShowAsync<SingleSelectionDialog>(L["ResourceReference_SelectType"], parameters, options);
    }

    private string GetKindDisplayText(ResourceKind kind)
        => kind switch
        {
            ResourceKind.Image => L["ResourceReference_Kind_Image"],
            ResourceKind.Video => L["ResourceReference_Kind_Video"],
            ResourceKind.Audio => L["ResourceReference_Kind_Audio"],
            ResourceKind.Document => L["ResourceReference_Kind_Document"],
            ResourceKind.Website => L["ResourceReference_Kind_Website"],
            ResourceKind.Other => L["ResourceReference_Kind_Other"],
            _ => kind.ToString()
        };
    private string GetKindDisplayText(ResourceKind? kind)
        => kind is null ? "" : GetKindDisplayText(kind.Value);

    public class ResourceReferenceEditModel
    {
        [StringLength(150)] public string? Name { get; set; }
        [StringLength(500)] public string Source { get; set; } = "";
        public ResourceKind Kind { get; set; } = ResourceKind.Other;
        [StringLength(500)] public string? Thumbnail { get; set; }
        public bool IsExternal { get; private set; } = true;

        public ResourceReferenceEditModel() { }

        public ResourceReferenceEditModel(ResourceReference? reference)
        {
            if (reference is not null)
            {
                Name = reference.Name;
                Source = reference.Source;
                Kind = reference.Kind;
                Thumbnail = reference.Thumbnail;
                IsExternal = reference.IsExternal;
            }
        }

        public ResourceReference ToResourceReference()
            => string.IsNullOrEmpty(Source) ? ResourceReference.Empty : ResourceReference.FromUrl(Name, Source, Thumbnail, Kind);
    }
}