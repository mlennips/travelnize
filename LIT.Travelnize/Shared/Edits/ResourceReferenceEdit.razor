@using System.ComponentModel.DataAnnotations
@using LIT.Travelnize.Domain.Common
@using LIT.Travelnize.Shared.Dialogs
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<EditForm Model="Model">
    <MudGrid Spacing="4">
        <MudItem xs="6" sm="3" lg="4">
            <MudStack Row AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="Model.Source"
                              Label="@L["ResourceReferenceEdit_SourceLabel"]"
                              For="@(() => Model.Source)"
                              HelperText="@($"{GetKindDisplayText(Model.Kind)} {L["ResourceReferenceEdit_Url"]}")"
                              Clearable />

                @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                {
                    <MudImage Src="@Model.Source"
                              Height="26"
                              Alt="@L["ResourceReferenceEdit_SourceLabel"]" />
                }
            </MudStack>
        </MudItem>
        <MudItem xs="6" sm="3" lg="4">
            <MudStack Row AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="Model.Thumbnail"
                              Label="@L["ResourceReferenceEdit_ThumbnailLabel"]"
                              HelperText="@L["ResourceReferenceEdit_Optional"]"
                              For="@(() => Model.Thumbnail)"
                              Clearable />

                @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                {
                    <MudImage Src="@Model.Thumbnail"
                              Height="26"
                              Alt="@L["ResourceReferenceEdit_ThumbnailLabel"]" />
                }
            </MudStack>
        </MudItem>
        <MudItem xs="9" sm="3" lg="2">
            <MudTextField @bind-Value="Model.Name"
                          Label="@L["ResourceReferenceEdit_NameLabel"]"
                          HelperText="@L["ResourceReferenceEdit_Optional"]"                          
                          For="@(() => Model.Name)" 
                          Clearable />
        </MudItem>
        <MudItem xs="3" sm="3" lg="2" Class="d-flex align-items-center justify-content-end">
            <MudButtonGroup Color="Color.Tertiary">
                <MudIconButton Variant="Variant.Filled"
                                Disabled="ForceKind != null"
                                OnClick="OpenKindDialog" 
                                Icon="@Icons.Material.Filled.Category"
                                title="@GetKindDisplayText(Model.Kind)">                    
                </MudIconButton>
            </MudButtonGroup>
        </MudItem>
        @* Optional: Extern-Flag, falls benötigt
        <MudItem xs="12" sm="6">
            <MudSwitch @bind-Checked="Model.IsExternal" Color="Color.Primary" Label="@L["ResourceReferenceEdit_ExternalLabel"]" />
        </MudItem>
        *@
    </MudGrid>
</EditForm>

@code {
    [Inject] IDialogService DialogService { get; set; } = default!;

    [Parameter, EditorRequired] public ResourceReferenceEditModel Model { get; set; } = new();
    [Parameter] public ResourceKind? ForceKind { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ForceKind != null && Model != null)
        {
            Model.Kind = ForceKind.Value;
        }
    }

    private async Task OpenKindDialog()
    {
        if (ForceKind != null)
            return;

        IDialogReference? dialog = null;
        var items = Enum.GetValues<ResourceKind>()
            .Select(kind => new SingleSelectionDialog.SingleSelectionItem(
                GetKindDisplayText(kind),
                () => { Model.Kind = kind; StateHasChanged(); dialog?.Close(); }
            )).ToList();

        var parameters = new DialogParameters { ["Items"] = items };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        dialog = await DialogService.ShowAsync<SingleSelectionDialog>(L["ResourceReferenceEdit_SelectType"], parameters, options);
    }

    private string GetKindDisplayText(ResourceKind kind)
        => kind switch
        {
            ResourceKind.Image => L["ResourceReferenceEdit_Kind_Image"],
            ResourceKind.Video => L["ResourceReferenceEdit_Kind_Video"],
            ResourceKind.Audio => L["ResourceReferenceEdit_Kind_Audio"],
            ResourceKind.Document => L["ResourceReferenceEdit_Kind_Document"],
            ResourceKind.Website => L["ResourceReferenceEdit_Kind_Website"],
            ResourceKind.Other => L["ResourceReferenceEdit_Kind_Other"],
            _ => kind.ToString()
        };
    private string GetKindDisplayText(ResourceKind? kind)
        => kind is null ? "" : GetKindDisplayText(kind.Value);

    public class ResourceReferenceEditModel
    {
        [StringLength(150)] public string? Name { get; set; }
        [StringLength(500)] public string Source { get; set; } = "";
        public ResourceKind Kind { get; set; } = ResourceKind.Other;
        [StringLength(500)] public string? Thumbnail { get; set; }
        public bool IsExternal { get; private set; } = true;

        public ResourceReferenceEditModel() { }

        public ResourceReferenceEditModel(ResourceReference? reference)
        {
            if (reference is not null)
            {
                Name = reference.Name;
                Source = reference.Source;
                Kind = reference.Kind;
                Thumbnail = reference.Thumbnail;
                IsExternal = reference.IsExternal;
            }
        }

        public ResourceReference ToResourceReference()
            => ResourceReference.FromUrl(Name, Source, Thumbnail, Kind);
    }
}