@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

@if (Slot is not null)
{
    <MudText Inline Typo="@Typo">@Slot.ToShortDateString()</MudText>
    @if (ShowDays)
    {
        <MudText Inline Typo="@Typo">
            (@Slot.TotalDays @(Slot.TotalDaysInclusive == 1 ? L["PlanningSlotDisplay_DaySingular"] : L["PlanningSlotDisplay_DayPlural"]))
        </MudText>
    }
}
else
{
    <MudText Typo="@Typo" Color="Color.Warning">@L["PlanningSlotDisplay_NoPeriod"]</MudText>
}

@code {
    [Parameter]
    public PlanningSlot? Slot { get; set; }
    [Parameter]
    public bool ShowDays { get; set; } = false;
    [Parameter]
    public MudBlazor.Typo Typo { get; set; } = Typo.caption;
}