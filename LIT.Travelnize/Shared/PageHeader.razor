@using MudBlazor

@if (ShowPageTitle)
{
    <PageTitle>Travelnize - @Title</PageTitle>
}


<MudStack Breakpoint="Breakpoint.MdAndUp" Spacing="0" StretchItems="StretchItems.Start" AlignItems="AlignItems.Start" Justify="Justify.FlexStart">
    <MudStack Row Spacing="0">
        @if (!string.IsNullOrEmpty(Image))
        {
            <MudAvatar Size="Size.Large" Class="bg-white mx-4">
                <MudImage Src="icon-192.png" Alt="Travelnize"></MudImage>
            </MudAvatar>
        }
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5" Class="fw-bold">@Title</MudText>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <MudText Typo="Typo.subtitle2" Class="fw-light">
                    @Subtitle
                </MudText>
            }
        </MudStack>
    </MudStack>

    <MudButtonGroup Variant="Variant.Text" Color="Color.Tertiary" Size="Size.Small">
        @if (Actions != null)
        {
            @foreach (var action in Actions)
            {
                <MudButton OnClick="@action.OnClick">
                    @if (!string.IsNullOrEmpty(action.Icon))
                    {
                        <MudIcon Icon="@action.Icon" />
                    }
                    @action.Text
                </MudButton>
            }
        }
    </MudButtonGroup>

</MudStack>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Image { get; set; } = "icon-192.png";
    [Parameter] public bool ShowPageTitle { get; set; } = true; 
    [Parameter] public IEnumerable<ButtonAction>? Actions { get; set; }
}